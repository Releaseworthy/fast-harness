// The custom window title bar (the window has no native frame): the sidebar
// toggle, the Settings and About menu buttons, the account usage pill and
// the minimize, maximize or restore and close buttons. The empty bar moves
// the window; a double click maximizes or restores it.
import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { IconButton } from "widgets.slint";

// A flat text menu button. The open page reads in the text colour, bold,
// with a 2px accent underline, so the state never rests on colour alone.
component MenuButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: 28px;
    width: label.preferred-width + 2 * Theme.space-m;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.accent-surface : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.text + (root.selected ? " (open)" : "");
    accessible-action-default => { root.clicked(); }
    label := Text {
        text: root.text;
        font-size: Theme.font-s;
        font-weight: root.selected ? 700 : 500;
        color: root.selected || ta.has-hover ? Theme.text : Theme.dim;
        vertical-alignment: center;
        accessible-role: none;
    }
    if root.selected: Rectangle {
        x: Theme.space-m;
        y: parent.height - 2px;
        width: parent.width - 2 * Theme.space-m;
        height: 2px;
        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Minimize, maximize or restore, close: 46 by 40 like the native ones.
component WindowButton inherits IconButton {
    width: 46px;
    height: 40px;
    border-radius: 0;
    icon-size: 16px;
}

export component TitleBar inherits Rectangle {
    in property <string> page;
    in property <bool> sidebar-open;
    in property <bool> maximized;
    callback toggle-sidebar();
    callback open-page(string);
    callback minimize();
    callback toggle-maximize();
    callback bar-clicked();
    callback close();
    height: 40px;
    background: transparent;
    WindowMoveArea {
        HorizontalLayout {
            padding-left: Theme.space-xs + 2px;
            spacing: Theme.space-xs;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.sidebar-open ? Icons.layout-sidebar-left : Icons.layout-sidebar-left-off;
                    label: root.sidebar-open ? "Hide the sidebar" : "Show the sidebar";
                    clicked => { root.toggle-sidebar(); }
                }
            }
            VerticalLayout {
                alignment: center;
                MenuButton { text: "Settings"; selected: root.page == "settings"; clicked => { root.open-page("settings"); } }
            }
            VerticalLayout {
                alignment: center;
                MenuButton { text: "About"; selected: root.page == "about"; clicked => { root.open-page("about"); } }
            }
            // Clicks on the empty bar: the app maximizes or restores on a
            // double click (the move area delays the press, so the
            // TouchArea double-clicked callback does not fire).
            TouchArea {
                horizontal-stretch: 1;
                clicked => { root.bar-clicked(); }
            }
            Rectangle { width: Theme.space-s; }
            WindowButton { icon: Icons.chrome-minimize; label: "Minimize"; clicked => { root.minimize(); } }
            WindowButton {
                icon: root.maximized ? Icons.chrome-restore : Icons.chrome-maximize;
                label: root.maximized ? "Restore" : "Maximize";
                clicked => { root.toggle-maximize(); }
            }
            WindowButton { icon: Icons.chrome-close; label: "Close"; danger: true; clicked => { root.close(); } }
        }
    }
}
