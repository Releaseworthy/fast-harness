// The colour roles and design tokens every view draws with. The Rust side
// (src/theme.rs) copies a `fast_harness_core::theme::Theme` into this global; the
// defaults are the dark theme so a preview without Rust looks the same.
export global Theme {
    in-out property <bool> dark: true;
    // The greyscale setting is at 50 or more: the logo uses its grey copy.
    in-out property <bool> greyscale;
    // The greyscale setting, 0 (full colour) to 100 (pure greys); already
    // applied to every colour below.
    in-out property <int> greyscale-level;
    // Window, transcript and page background; the start of the background gradient.
    in-out property <color> bg: #0f1117;
    // The end of the background gradient (bg top left, bg-end bottom right).
    in-out property <color> bg-end: #151a2b;
    // Sidebar, status bar, cards and the composer.
    in-out property <color> surface: #161a24;
    // Inputs, dropdowns and buttons at rest.
    in-out property <color> raised: #1d2230;
    in-out property <color> hover: #252b3c;
    in-out property <color> selection: #283256;
    in-out property <color> bubble: #222a48;
    in-out property <color> code: #131722;
    // A surface tinted with the accent: active navigation item, highlighted card.
    in-out property <color> accent-surface: #1e2747;
    // Decorative separators only (no contrast requirement).
    in-out property <color> line: #2a3042;
    // Borders of inputs, dropdowns and buttons (3:1 against the backgrounds).
    in-out property <color> border: #77809c;
    in-out property <color> text: #eceef6;
    in-out property <color> dim: #b8bed4;
    // Links, the focus ring, active markers and the primary button.
    in-out property <color> accent: #98b6ff;
    // The second accent: the end of accent gradients and secondary highlights.
    in-out property <color> accent2: #c8a8ff;
    // Text and icons on accent, accent2 and a gradient between them.
    in-out property <color> on-accent: #0a0d18;
    // Coloured glow around the focused or primary element (use with transparency).
    in-out property <color> glow: #5b7cff;
    // Drop shadows of cards, popups and menus (use with transparency).
    in-out property <color> shadow: #04050a;
    in-out property <color> error: #ff9a9a;
    in-out property <color> warning: #ffcb70;
    in-out property <color> success: #74e8a8;
    in-out property <color> info: #82d4ff;

    // Radius, spacing and type scale.
    out property <length> radius-s: 6px;
    out property <length> radius-m: 8px;
    out property <length> radius-l: 12px;
    out property <length> radius-xl: 16px;
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 24px;
    out property <length> space-xxl: 32px;
    // Captions, labels, body, card titles and page titles.
    out property <length> font-xs: 11px;
    out property <length> font-s: 12px;
    out property <length> font-m: 14px;
    out property <length> font-l: 18px;
    out property <length> font-xl: 24px;
    // Hover and press transitions.
    out property <duration> quick: 120ms;
    // Controls are at least this tall (WCAG 2.5.8 asks for 24px).
    out property <length> control-height: 32px;
    // The chat and accounts columns never grow wider than this.
    out property <length> column-width: 860px;
    out property <string> mono: "Consolas";
    // Icons and status marks: the Nerd Font subset in fonts/ (see icons.slint).
    out property <string> symbols: "Fast Harness Icons";
}

// Side padding that centres a column of at most `Theme.column-width`.
export global Columns {
    pure public function side(width: length, max-width: length) -> length {
        return max(Theme.space-l, (width - max-width) / 2);
    }
    // The chat column's side margin (D77): the right one holds the turn
    // navigator, the left one matches so the column stays centred. A
    // narrow view shrinks the margins before the content.
    pure public function chat(width: length) -> length {
        return max(max(Theme.space-l, min(48px, (width - 480px) / 6)), (width - Theme.column-width) / 2);
    }
}

// A small clickable text (keyboard reachable through the accessibility
// action; the pages also offer every action as a button).
export component LinkText inherits Text {
    callback clicked();
    color: ta.has-hover ? Theme.accent : Theme.dim;
    font-size: Theme.font-xs;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A label, a bar filled to `value` (0 to 1) and a caption. The fill colour
// follows the level; the caption carries the number, so colour is never
// the only cue (WCAG 1.4.1).
export component UsageBar {
    in property <string> label;
    in property <float> value;
    in property <string> caption;
    in property <length> label-width: 22px;
    min-height: 16px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.caption;
    HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: root.label;
            width: root.label-width;
            font-size: Theme.font-xs;
            color: Theme.dim;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                border-radius: 3px;
                background: Theme.line;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, root.value));
                    height: parent.height;
                    border-radius: 3px;
                    background: root.value >= 0.9 ? Theme.error : root.value >= 0.7 ? Theme.warning : Theme.success;
                }
            }
        }
        Text {
            text: root.caption;
            font-size: Theme.font-xs;
            color: Theme.dim;
            vertical-alignment: center;
        }
    }
}

// The accent gradient (accent to accent2, left to right) on a rounded
// shape. The software renderer fills a gradient with square corners (it
// ignores border-radius and the clip ignores the radius too), so the
// corners are solid rounded caps in the two end colours and the gradient is
// a square band between them. Narrower than 4 * radius (a circle, a small
// tile) it is one solid fill halfway between the two colours.
export component AccentFill inherits Rectangle {
    in property <length> radius: Theme.radius-m;
    in property <color> from: Theme.accent;
    in property <color> to: Theme.accent2;
    property <bool> band: root.width >= 4 * root.radius;
    if !root.band: Rectangle { border-radius: root.radius; background: root.from.mix(root.to, 0.5); }
    if root.band: Rectangle { border-radius: root.radius; background: root.from; }
    if root.band: Rectangle {
        x: root.width / 2;
        width: root.width / 2;
        border-radius: root.radius;
        background: root.to;
    }
    if root.band: Rectangle {
        x: root.radius;
        width: root.width - 2 * root.radius;
        background: @linear-gradient(90deg, root.from 0%, root.to 100%);
    }
}

// A coloured halo around its parent (hover and focus): one 3px ring of the
// glow colour on whole pixels. Two stacked translucent rings (5px and 2px
// out) read as a doubled, smeared edge (D75).
export component Halo inherits Rectangle {
    in property <length> radius: Theme.radius-m;
    in property <float> strength: 1;
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.radius + 3px;
        border-width: 3px;
        border-color: Theme.glow.with-alpha(0.28 * root.strength);
    }
}

// Elevation under a card: one blurred drop shadow. Skia
// (the default, D78) draws it; the software renderer draws no drop shadow,
// so there the card is flat. The fill sits under the card's own fill, same
// shape, and never shows. Three offset translucent fills did this before
// and drew stepped ghost edges under every card.
export component Elevation inherits Rectangle {
    in property <length> radius: Theme.radius-l;
    in property <float> level: 1;
    property <float> k: (Theme.dark ? 1.6 : 1) * root.level;
    Rectangle {
        border-radius: root.radius;
        background: Theme.bg;
        drop-shadow-blur: 6px * root.level;
        drop-shadow-offset-y: 2px * root.level;
        drop-shadow-color: Theme.shadow.with-alpha(min(0.6, 0.3 * root.k));
    }
}

// A raised card: elevation, a fill, a 1px edge, then the children.
export component Card inherits Rectangle {
    in property <length> radius: Theme.radius-l;
    in property <brush> fill: Theme.surface;
    in property <brush> edge: Theme.line;
    in property <float> elevation: 1;
    if root.elevation > 0: Elevation { radius: root.radius; level: root.elevation; }
    Rectangle {
        border-radius: root.radius;
        background: root.fill;
        border-width: 1px;
        border-color: root.edge;
    }
    @children
}

// A page title: a short gradient bar and the title in the large size.
export component PageTitle inherits HorizontalLayout {
    in property <string> text;
    spacing: Theme.space-m;
    VerticalLayout {
        alignment: center;
        AccentFill { width: 20px; height: 6px; radius: 3px; }
    }
    Text {
        text: root.text;
        color: Theme.text;
        font-size: Theme.font-xl;
        font-weight: 700;
        vertical-alignment: center;
        horizontal-stretch: 1;
    }
}

// An uppercase section caption.
export component Eyebrow inherits Text {
    color: Theme.dim;
    font-size: Theme.font-xs;
    font-weight: 700;
    letter-spacing: 0.8px;
}

// A small rounded tag. `strong` uses the accent gradient.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    border-radius: 4px;
    background: root.strong ? transparent : Theme.raised;
    border-width: root.strong ? 0px : 1px;
    border-color: Theme.line;
    if root.strong: AccentFill { radius: 4px; }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            font-size: Theme.font-xs;
            color: root.strong ? Theme.on-accent : Theme.dim;
            vertical-alignment: center;
        }
    }
}

// An icon or status mark (a code point from `Icons`) drawn with the icon font.
export component Mark inherits Text {
    font-family: Theme.symbols;
    vertical-alignment: center;
    accessible-role: none;
}