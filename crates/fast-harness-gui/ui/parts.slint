// The colour roles and design tokens every view draws with. The Rust side
// (src/theme.rs) copies a `fast_harness_core::theme::Theme` into this global; the
// defaults are the dark theme so a preview without Rust looks the same.
export global Theme {
    in-out property <bool> dark: true;
    // The greyscale setting is at 50 or more: the logo uses its grey copy.
    in-out property <bool> greyscale;
    // The greyscale setting, 0 (full colour) to 100 (pure greys); already
    // applied to every colour below.
    in-out property <int> greyscale-level;
    // Window, transcript and page background; the start of the background gradient.
    in-out property <color> bg: #0f1117;
    // The end of the background gradient (bg top left, bg-end bottom right).
    in-out property <color> bg-end: #151a2b;
    // Sidebar, status bar, cards and the composer.
    in-out property <color> surface: #161a24;
    // Inputs, dropdowns and buttons at rest.
    in-out property <color> raised: #1d2230;
    in-out property <color> hover: #252b3c;
    in-out property <color> selection: #283256;
    in-out property <color> bubble: #222a48;
    in-out property <color> code: #131722;
    // A surface tinted with the accent: active navigation item, highlighted card.
    in-out property <color> accent-surface: #1e2747;
    // Decorative separators only (no contrast requirement).
    in-out property <color> line: #2a3042;
    // Borders of inputs, dropdowns and buttons (3:1 against the backgrounds).
    in-out property <color> border: #77809c;
    in-out property <color> text: #eceef6;
    in-out property <color> dim: #b8bed4;
    // Links, the focus ring, active markers and the primary button.
    in-out property <color> accent: #98b6ff;
    // The second accent: the end of accent gradients and secondary highlights.
    in-out property <color> accent2: #c8a8ff;
    // Text and icons on accent, accent2 and a gradient between them.
    in-out property <color> on-accent: #0a0d18;
    // Coloured glow around the focused or primary element (use with transparency).
    in-out property <color> glow: #5b7cff;
    // Drop shadows of cards, popups and menus (use with transparency).
    in-out property <color> shadow: #04050a;
    in-out property <color> error: #ff9a9a;
    in-out property <color> warning: #ffcb70;
    in-out property <color> success: #74e8a8;
    in-out property <color> info: #82d4ff;

    // Radius, spacing and type scale.
    out property <length> radius-s: 6px;
    out property <length> radius-m: 8px;
    out property <length> radius-l: 12px;
    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 24px;
    out property <length> font-xs: 11px;
    out property <length> font-s: 12px;
    out property <length> font-m: 14px;
    out property <length> font-l: 18px;
    // Controls are at least this tall (WCAG 2.5.8 asks for 24px).
    out property <length> control-height: 32px;
    // The chat and accounts columns never grow wider than this.
    out property <length> column-width: 860px;
    out property <string> mono: "Consolas";
    // Icons and status marks: the Nerd Font subset in fonts/ (see icons.slint).
    out property <string> symbols: "Fast Harness Icons";
}

// Side padding that centres a column of at most `Theme.column-width`.
export global Columns {
    pure public function side(width: length, max-width: length) -> length {
        return max(Theme.space-l, (width - max-width) / 2);
    }
}

// A small clickable text (keyboard reachable through the accessibility
// action; the pages also offer every action as a button).
export component LinkText inherits Text {
    callback clicked();
    color: ta.has-hover ? Theme.accent : Theme.dim;
    font-size: Theme.font-xs;
    accessible-role: button;
    accessible-label: self.text;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// A label, a bar filled to `value` (0 to 1) and a caption. The fill colour
// follows the level; the caption carries the number, so colour is never
// the only cue (WCAG 1.4.1).
export component UsageBar {
    in property <string> label;
    in property <float> value;
    in property <string> caption;
    in property <length> label-width: 22px;
    min-height: 16px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    accessible-value: root.caption;
    HorizontalLayout {
        spacing: Theme.space-s;
        Text {
            text: root.label;
            width: root.label-width;
            font-size: Theme.font-xs;
            color: Theme.dim;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                border-radius: 3px;
                background: Theme.line;
                Rectangle {
                    x: 0;
                    width: parent.width * max(0, min(1, root.value));
                    height: parent.height;
                    border-radius: 3px;
                    background: root.value >= 0.9 ? Theme.error : root.value >= 0.7 ? Theme.warning : Theme.success;
                }
            }
        }
        Text {
            text: root.caption;
            font-size: Theme.font-xs;
            color: Theme.dim;
            vertical-alignment: center;
        }
    }
}

// A small rounded tag. `strong` uses the accent colours.
export component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> strong;
    border-radius: 4px;
    background: root.strong ? Theme.accent : Theme.raised;
    border-width: root.strong ? 0px : 1px;
    border-color: Theme.line;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            font-size: Theme.font-xs;
            color: root.strong ? Theme.on-accent : Theme.dim;
            vertical-alignment: center;
        }
    }
}

// An icon or status mark (a code point from `Icons`) drawn with the icon font.
export component Mark inherits Text {
    font-family: Theme.symbols;
    vertical-alignment: center;
    accessible-role: none;
}