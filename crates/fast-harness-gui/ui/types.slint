// Rows the Rust side fills (src/rows.rs maps the core types to these).

// A tool card chip (`fast_harness_core::view::Chip`). `tone`: plain,
// success, error, info or warning; the text always says what it means.
export struct ToolChip {
    text: string,
    tone: string,
}

// The chips of one line of the card (src/tool_rows.rs splits them).
export struct ChipRow {
    chips: [ToolChip],
}

// A labelled argument; `preview` is its first lines (collapsed card).
export struct ToolField {
    label: string,
    value: string,
    preview: string,
}

// One line of the code view. `kind`: context, added, removed, header, gap
// or file (a glob path: `old` its folder with the separator, `text` the
// name); `old` and `new` are line numbers as text, "" when none.
export struct CodeLine {
    kind: string,
    old: string,
    new: string,
    text: string,
}

// What a tool card draws (src/tool_rows.rs maps `view::ToolDetail`).
// `kind`: read, write, edit, grep, glob, shell, subagent, find or other;
// "" for rows without tool information.
export struct ToolView {
    kind: string,
    // The tool's name as the model called it.
    name: string,
    // The file name (read, write, edit), pattern, command or description,
    // and the folder of a file target.
    target: string,
    target-dir: string,
    // The chips split for a narrow card and for a wide one (ui/toolcard.slint
    // picks by the real width).
    chip-rows: [ChipRow],
    chip-rows-wide: [ChipRow],
    fields: [ToolField],
    // Every line (at most 200) and the first ones (collapsed card).
    lines: [CodeLine],
    lines-preview: [CodeLine],
    // Lines the core cut ("120 more lines not shown; Copy takes all").
    lines-note: string,
    // An edit diff: old and new number columns.
    two-numbers: bool,
    // Digits of the widest line number (the number column width).
    digits: int,
    // The output as text when there are no lines, and its first lines.
    text: string,
    text-preview: string,
    // Anything beyond the preview, and the words of the link that opens it.
    more: bool,
    more-label: string,
}

// An image attached to the next prompt or shown in a user row (D70): its
// thumbnail (empty until decoded), its label in words, its file and place.
export struct ImageChip {
    thumb: image,
    label: string,
    path: string,
    index: int,
}

// One transcript entry. `kind`: user, assistant, tool, note or footer.
export struct MsgRow {
    kind: string,
    // A user message's images (D70), drawn as thumbnails above its text.
    images: [ImageChip],
    // Plain text: what Copy puts on the clipboard.
    text: string,
    // `text` as drawn: cut under the software renderer's i16 pixel limit.
    shown: string,
    // Assistant text parsed from markdown.
    body: styled-text,
    thinking: string,
    // Tool name and one-line summary of its arguments.
    title: string,
    summary: string,
    // Tool output as shown (shortened when long).
    output: string,
    // The newest lines of a running tool's output; empty after its result.
    live: string,
    running: bool,
    error: bool,
    // A call the approval gate ended before it ran (`declined`, `cancelled`,
    // `paused`, `refused`): it is not a failed call (D64).
    not-run: bool,
    // Thinking or tool output opened by the user.
    expanded: bool,
    // Note kind: retry, switch, error or info.
    tone: string,
    // The tool card (kind "tool").
    tool: ToolView,
    // How the call's approval went (D64): "waiting for your answer",
    // "allowed once", "declined", ...; empty when it never asked. Live only.
    approval: string,
    // The step line (D73) on a step's first row: what the step did in
    // words; empty under `chatDetail: "full"` and on other rows.
    step-summary: string,
    // The line with counts (accessible label, tooltip).
    step-label: string,
    step-open: bool,
    // The row of the step's line; an opened step's rows draw the rail
    // (a faint line on the left) whose click folds the step.
    step-head: int,
    rail: bool,
    step-running: bool,
    step-failed: bool,
    // The row's detail is folded into its step line (an assistant row keeps
    // its text and folds its thinking).
    folded: bool,
}

// The approval prompt (D64); an empty `id` for none. `title` says what the
// call will do, `text` the whole command or path, `agent` the subagent that
// asks, `more` how many requests wait after it, and the keys of the answers.
export struct ApprovalView {
    id: string,
    title: string,
    text: string,
    agent: string,
    more: string,
    once-key: string,
    session-key: string,
    decline-key: string,
}

// One entry of the trace timeline (src/trace_rows.rs). `kind`: turn, user,
// header, request, thinking, response, call, result, answer, retry,
// failure, switch or end.
export struct TraceRow {
    kind: string,
    title: string,
    // The full body (shortened when huge) and what a collapsed one shows.
    body: string,
    preview: string,
    // Starts collapsed; `expanded` once the user picked Show all.
    long: bool,
    expanded: bool,
    error: bool,
    // What Copy puts on the clipboard: the title and the whole body.
    copy: string,
    // Tool calls and results with tool information (kind "" otherwise).
    tool: ToolView,
}

// A sidebar row: kind "workspace" (id and detail: the folder path; title: its name)
// or "session" (id: the session id; workspace: its folder; detail: the time;
// run: "waiting" (an approval request, D64), "running", "paused",
// "interrupted", "cancelled" or empty, D39).
export struct SideRow {
    kind: string,
    id: string,
    workspace: string,
    title: string,
    detail: string,
    current: bool,
    expanded: bool,
    run: string,
}

// A text waiting above the composer: index -1 for a steer the running turn
// has not read yet, else its place in the follow-up queue.
export struct QueueChip {
    index: int,
    text: string,
}

// A background job of the shown session (PLAN.md D68): `mark` is its
// state's name (running, exited, failed, killed), `word` says it in text.
export struct JobChip {
    id: string,
    command: string,
    word: string,
    mark: string,
}

export struct SessionRow {
    id: string,
    title: string,
    time: string,
    current: bool,
}

export struct AccountRow {
    id: string,
    name: string,
    kind: string,
    plan: string,
    active: bool,
    five: float,
    five-text: string,
    seven: float,
    seven-text: string,
    hold: string,
    token-ok: bool,
}

// One provider card of the Accounts page (src/providers.rs, PLAN.md D32).
// `id`: claude. `tone`: ready, empty or attention (the status
// words always say what the colour means).
export struct ProviderCard {
    id: string,
    name: string,
    count: string,
    status: string,
    tone: string,
    // The lowest quota left of the active account (0 to 1), when known.
    has-left: bool,
    left: float,
    left-text: string,
}

// The next undo of the shown session (D69, src/undo_view.rs): `turn` 0 hides
// the row; `summary`, `blocked` (cannot be undone) and `conflict` (files
// changed since that turn, offering Undo anyway) are words.
export struct UndoBar {
    turn: int,
    summary: string,
    blocked: string,
    conflict: string,
}
