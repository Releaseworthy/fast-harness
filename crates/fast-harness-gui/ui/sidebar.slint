import { ListView } from "std-widgets.slint";
import { ScrollBar } from "scrollbar.slint";
import { SideRow } from "types.slint";
import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, IconButton } from "widgets.slint";
// A selected row: the selection colour, an accent bar on the left and a
// heavier weight, so the state shows without colour alone.
component RowMark inherits Rectangle {
    in property <bool> selected;
    in property <bool> hovered;
    border-radius: Theme.radius-s;
    background: root.selected ? Theme.selection : root.hovered ? Theme.hover : transparent;
    if root.selected: Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: parent.height - 14px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
}


// A page entry: an icon and a word; the open page uses RowMark.
component NavEntry inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    height: Theme.control-height + 4px;
    accessible-role: button;
    accessible-label: root.text + (root.selected ? " (open)" : "");
    accessible-action-default => { root.clicked(); }
    RowMark { selected: root.selected; hovered: ta.has-hover; }
    HorizontalLayout {
        padding-left: Theme.space-m;
        spacing: Theme.space-s + 2px;
        alignment: start;
        Mark { text: root.icon; color: Theme.text; font-size: Theme.font-l - 2px; }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-m;
            font-weight: root.selected ? 600 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The brand: the app icon, the lowercase wordmark and a HARNESS badge.
component Logo inherits HorizontalLayout {
    spacing: Theme.space-s;
    alignment: start;
    accessible-role: text;
    accessible-label: "Fast Harness";
    VerticalLayout {
        alignment: center;
        Image {
            width: 22px;
            height: 22px;
            source: Theme.greyscale ? @image-url("../assets/fast-harness-grey-64.png") : @image-url("../assets/fast-harness-64.png");
            accessible-role: none;
        }
    }
    Text {
        text: "fast";
        color: Theme.text;
        font-size: Theme.font-l;
        font-weight: 800;
        vertical-alignment: center;
        accessible-role: none;
    }
    VerticalLayout {
        alignment: center;
        Rectangle {
            border-radius: 3px;
            background: Theme.text;
            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                padding-top: 1px;
                padding-bottom: 1px;
                Text {
                    text: "HARNESS";
                    color: Theme.bg;
                    font-size: Theme.font-xs;
                    font-weight: 700;
                    letter-spacing: 0.8px;
                    accessible-role: none;
                }
            }
        }
    }
}

// A workspace folder: a folder icon (open for the current one), the folder name,
// the full path below it for the current one; a remove button on hover.
component WorkspaceEntry inherits Rectangle {
    in property <SideRow> entry;
    callback clicked();
    callback remove();
    height: 36px;
    accessible-role: list-item;
    accessible-label: root.entry.detail + (root.entry.expanded ? " (expanded)" : " (collapsed)");
    accessible-item-selected: root.entry.current;
    accessible-action-default => { root.clicked(); }
    wta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        RowMark { selected: root.entry.current; hovered: wta.has-hover; }
        HorizontalLayout {
            padding-left: Theme.space-s + 2px;
            padding-right: Theme.space-xs;
            spacing: Theme.space-s;
            Mark {
                text: root.entry.expanded ? Icons.chevron-down : Icons.chevron-right;
                color: Theme.dim;
                font-size: Theme.font-s;
            }
            Mark {
                text: root.entry.current ? Icons.folder-opened : Icons.folder;
                color: Theme.text;
                font-size: Theme.font-l - 2px;
            }
            Text {
                text: root.entry.title;
                horizontal-stretch: 1;
                overflow: elide;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: root.entry.current ? 600 : 500;
                vertical-alignment: center;
            }
            if wta.has-hover: VerticalLayout {
                alignment: center;
                IconButton {
                    width: 24px;
                    height: 24px;
                    icon: Icons.close;
                    icon-size: Theme.font-s;
                    label: "Remove from list";
                    clicked => { root.remove(); }
                }
            }
        }
    }
}

// A session under its workspace, indented past the folder icon.
component SessionEntry inherits Rectangle {
    in property <SideRow> entry;
    callback clicked();
    height: 44px;
    accessible-role: list-item;
    accessible-label: root.entry.title;
    accessible-item-selected: root.entry.current;
    accessible-action-default => { root.clicked(); }
    RowMark { selected: root.entry.current; hovered: sta.has-hover; }
    VerticalLayout {
        padding-left: Theme.space-m + 30px;
        padding-right: Theme.space-s;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.entry.title;
            overflow: elide;
            color: Theme.text;
            font-size: Theme.font-m;
            font-weight: root.entry.current ? 600 : 400;
        }
        Text { text: root.entry.detail; font-size: Theme.font-xs; color: Theme.dim; }
    }
    sta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Sidebar inherits Rectangle {
    in property <[SideRow]> rows;
    in property <string> page;
    callback new-session();
    callback add-workspace();
    callback select-workspace(string);
    callback remove-workspace(string);
    callback open-session(string, string);
    callback open-page(string);
    width: 260px;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-m;
        padding-top: Theme.space-xs;
        spacing: Theme.space-xs;
        Logo { height: 32px; }
        Rectangle { height: Theme.space-s; }
        ActionButton {
            icon: Icons.add;
            text: "New session";
            clicked => { root.new-session(); }
        }
        HorizontalLayout {
            height: 32px;
            Text {
                text: "WORKSPACES";
                horizontal-stretch: 1;
                font-size: Theme.font-xs;
                font-weight: 600;
                letter-spacing: 0.6px;
                color: Theme.dim;
                vertical-alignment: bottom;
            }
            VerticalLayout {
                alignment: end;
                IconButton {
                    width: 26px;
                    height: 26px;
                    icon: Icons.new-folder;
                    icon-size: Theme.font-m;
                    label: "Add workspace";
                    clicked => { root.add-workspace(); }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            side-list := ListView {
            width: 100%;
            height: 100%;
            vertical-scrollbar-policy: ScrollBarPolicy.always-off;
            for r in root.rows: VerticalLayout {
                if r.kind == "workspace": WorkspaceEntry {
                    entry: r;
                    clicked => { root.select-workspace(r.id); }
                    remove => { root.remove-workspace(r.id); }
                }
                if r.kind == "session": SessionEntry {
                    entry: r;
                    clicked => { root.open-session(r.workspace, r.id); }
                }
            }
            }
            ScrollBar {
                x: parent.width - self.width;
                height: parent.height;
                content-y: side-list.content-y;
                content-height: side-list.content-height;
                visible-height: side-list.visible-height;
                scroll-to(y) => { side-list.content-y = y; }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        Rectangle { height: Theme.space-xs; }
        NavEntry {
            icon: Icons.account;
            text: "Accounts";
            selected: root.page == "accounts";
            clicked => { root.open-page("accounts"); }
        }
    }
}
