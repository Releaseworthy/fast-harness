import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { FocusRing } from "widgets.slint";

// A tab after Chat and Trace that opens a popover under it (PLAN.md D76;
// the subagents D74 and the background jobs D72): an icon, the word, the
// count in a badge with a dot while something runs (the shape, not the
// colour alone, says it; the accessible label says "running"). A click,
// Enter or Space asks for the popover; the chat stays visible under it.
export component PopTab inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <int> count;
    in property <bool> running;
    // The accessible label: "Subagents: 3, 2 running".
    in property <string> label;
    in property <bool> open;
    // A click: open or close. Enter or Space on the focused tab: open.
    callback toggle();
    callback show();
    width: row.preferred-width;
    border-radius: Theme.radius-m;
    background: ta.has-hover || root.open ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.toggle(); }
    row := HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-s + 2px;
        spacing: Theme.space-s;
        Mark {
            text: root.icon;
            font-size: Theme.font-m;
            color: root.running ? Theme.accent : Theme.dim;
        }
        Text {
            text: root.text;
            font-size: Theme.font-s;
            font-weight: 500;
            color: root.open ? Theme.text : Theme.dim;
            vertical-alignment: center;
            accessible-role: none;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                height: 18px;
                width: max(18px, badge.preferred-width);
                border-radius: 9px;
                background: Theme.raised;
                border-width: 1px;
                border-color: Theme.line;
                badge := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    if root.running: Mark { text: Icons.circle-filled; color: Theme.accent; font-size: 7px; }
                    Text {
                        text: root.count;
                        color: Theme.text;
                        font-size: Theme.font-xs;
                        font-weight: 600;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }
            }
        }
        Mark {
            text: root.open ? Icons.chevron-up : Icons.chevron-down;
            color: Theme.dim;
            font-size: Theme.font-xs;
        }
    }
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.show();
                return accept;
            }
            return reject;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.toggle();
        }
    }
    if fs.has-focus: FocusRing { radius: Theme.radius-m + 3px; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

// The popover's card: surface, rounded border and the neutral shadow.
export component PopoverCard inherits Rectangle {
    background: Theme.surface;
    border-radius: Theme.radius-l;
    border-width: 1px;
    border-color: Theme.border;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000040;
}
