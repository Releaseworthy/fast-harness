import { Theme, Card, Halo } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, TextArea } from "widgets.slint";

// The message composer: a rounded card with the text area on top and a
// toolbar below. Children placed inside `Composer { ... }` go to the left
// slot of the toolbar (a HorizontalLayout), e.g. model and effort dropdowns.
export component Composer inherits Rectangle {
    in-out property <string> text <=> area.text;
    in property <bool> busy;
    in property <string> hint: "Enter to send · Shift+Enter for a new line";
    // A note that replaces the hint until the next send (e.g. the effort
    // changed with the model).
    in property <string> note;
    // Fired on Enter or the Send button; the parent clears `text` itself.
    callback submit();
    callback stop();
    public function focus-input() { area.focus(); }
    // A floating card: elevation, a glow halo and an accent edge while focused.
    if area.has-focus: Halo { radius: Theme.radius-xl; }
    Card {
        radius: Theme.radius-xl;
        elevation: 2;
        edge: area.has-focus ? Theme.accent : Theme.border;
    }
    if area.has-focus: Rectangle {
        border-radius: Theme.radius-xl;
        border-width: 2px;
        border-color: Theme.accent;
    }
    VerticalLayout {
        padding: Theme.space-m;
        padding-top: Theme.space-m + 2px;
        spacing: Theme.space-s;
        area := TextArea {
            placeholder: "Message Fast Harness";
            key-pressed(event) => {
                if (event.text == Key.Return && !event.modifiers.shift) {
                    if (!root.busy) {
                        root.submit();
                    }
                    return accept;
                }
                return reject;
            }
        }
        HorizontalLayout {
            spacing: Theme.space-s;
            toolbar-left := HorizontalLayout {
                spacing: Theme.space-s;
                alignment: start;
                @children
            }
            Text {
                text: root.note != "" ? root.note : root.hint;
                color: root.note != "" ? Theme.text : Theme.dim;
                font-size: root.note != "" ? Theme.font-s : Theme.font-xs;
                wrap: root.note != "" ? word-wrap : no-wrap;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            ActionButton {
                icon: root.busy ? Icons.debug-stop : Icons.send;
                text: root.busy ? "Stop" : "Send";
                variant: root.busy ? "secondary" : "primary";
                min-width: 96px;
                clicked => {
                    if (root.busy) {
                        root.stop();
                    } else {
                        root.submit();
                    }
                }
            }
        }
    }
}
