import { Theme, Card, Halo } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, IconButton } from "widgets.slint";
import { TextArea } from "textarea.slint";

// The composer's caret rest (`src/window_events.rs`): Rust reads whether the
// composer has focus, and the composer keeps its focus look while its caret
// rests (Slint then sees the window inactive, so `has-focus` is false).
export global Caret {
    in-out property <bool> composer;
    in-out property <bool> resting;
}

// The message composer: a rounded card with the text area on top and a
// toolbar below. Children placed inside `Composer { ... }` go to the left
// slot of the toolbar (a HorizontalLayout), e.g. model and effort dropdowns.
export component Composer inherits Rectangle {
    in-out property <string> text <=> area.text;
    in property <bool> busy;
    // A session is opening on a worker (D60): Send waits for it, and the
    // hint says so in words.
    in property <bool> loading;
    // The keys bound to send and queue (keys.json, PLAN.md D45).
    in property <string> send-key: "Enter";
    in property <string> queue-key: "Alt+Enter";
    in property <string> hint: root.send-key + " to send · Shift+Enter for a new line";
    // How the last turn stopped when Resume applies (D39), else empty.
    in property <string> resume-word;
    // A note that replaces the hint until the next send (e.g. the effort
    // changed with the model).
    in property <string> note;
    // Fired on Enter or the Send button; the parent clears `text` itself.
    callback submit();
    callback stop();
    // Alt+Enter: queue a follow-up while busy.
    callback queue();
    callback pause();
    callback resume();
    // Opens the image file dialog (D70).
    callback attach();
    // A key in the message box: true when the app ran its action.
    callback shortcut(KeyEvent) -> bool;
    property <string> busy-hint: root.send-key + " steers · " + root.queue-key + " queues";
    property <string> shown-hint: root.loading ? "Loading the session…"
        : root.busy ? root.busy-hint
        : root.resume-word != "" ? "Last turn " + root.resume-word + ": Resume continues it"
        : root.hint;
    public function focus-input() { area.focus(); }
    // Shows another session's draft (D65): its text, the cursor at byte `cursor`.
    public function show-text(text: string, cursor: int) {
        area.text = text;
        area.set-cursor(cursor);
    }
    property <bool> focused: area.has-focus;
    changed focused => { Caret.composer = self.focused; }
    property <bool> lit: area.has-focus || Caret.resting;
    // A floating card: elevation, a glow halo and an accent edge while focused.
    if root.lit: Halo { radius: Theme.radius-xl; }
    Card {
        radius: Theme.radius-xl;
        elevation: 2;
        edge: root.lit ? Theme.accent : Theme.border;
    }
    if root.lit: Rectangle {
        border-radius: Theme.radius-xl;
        border-width: 2px;
        border-color: Theme.accent;
    }
    VerticalLayout {
        padding: Theme.space-m;
        padding-top: Theme.space-m + 2px;
        spacing: Theme.space-s;
        area := TextArea {
            placeholder: "Message Fast Harness";
            // Send, steer, queue and stop go by keys.json; other keys edit.
            key-pressed(event) => { return root.shortcut(event) ? accept : reject; }
        }
        HorizontalLayout {
            spacing: Theme.space-s;
            toolbar-left := HorizontalLayout {
                spacing: Theme.space-s;
                alignment: start;
                IconButton {
                    icon: Icons.file;
                    label: "Attach an image";
                    clicked => { root.attach(); }
                }
                @children
            }
            Text {
                text: root.note != "" ? root.note : root.shown-hint;
                color: root.note != "" ? Theme.text : Theme.dim;
                font-size: root.note != "" ? Theme.font-s : Theme.font-xs;
                wrap: root.note != "" ? word-wrap : no-wrap;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.busy: ActionButton {
                icon: Icons.debug-pause;
                text: "Pause";
                clicked => { root.pause(); }
            }
            if !root.busy && root.resume-word != "": ActionButton {
                icon: Icons.refresh;
                text: "Resume";
                clicked => { root.resume(); }
            }
            ActionButton {
                icon: root.busy ? Icons.debug-stop : Icons.send;
                text: root.busy ? "Stop" : "Send";
                variant: root.busy ? "secondary" : "primary";
                min-width: 96px;
                // Send waits for an opening session; Stop always stops the
                // shown session's running turn (composer_tests.rs).
                enabled: root.busy || !root.loading;
                clicked => {
                    if (root.busy) {
                        root.stop();
                    } else {
                        root.submit();
                    }
                }
            }
        }
    }
}
