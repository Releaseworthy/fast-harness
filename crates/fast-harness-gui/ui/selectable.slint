// Text the mouse can select (a drag; a double click picks a word, a triple
// click the paragraph) and Ctrl+C copies (2026-11-14). Slint 1.18.1's Text
// and StyledText are not selectable, so blocks of plain text are a read-only
// TextInput drawn as the Text was. In i-slint-core 1.18.1 items/text.rs a
// press grabs the mouse, so a drag selects within this one block and never
// scrolls the list or hits a fold header; the wheel is ignored and passes on
// to the list; read-only, it opens no IME and Cut, Paste, Undo and typing do
// nothing, while Copy and Select All work.
import { Theme } from "parts.slint";

export component SelectableText inherits TextInput {
    read-only: true;
    single-line: false;
    wrap: word-wrap;
    color: Theme.text;
    selection-background-color: Theme.selection;
    selection-foreground-color: Theme.text;
}

// Select mode for an assistant reply (src/reply_select.rs): the reply in it
// (transcript row `item`, -1 for none) and its plain text. `drawn` is what
// the drawn copy holds (for the tests).
export global ReplySelect {
    in-out property <int> item: -1;
    in property <string> text;
    in-out property <string> drawn;
    callback enter(int);
}

// A reply in select mode: its plain text, every line selected; Esc or the
// focus moving elsewhere ends it. A read-only TextInput passes Esc on to
// this FocusScope (i-slint-core 1.18.1 items/text.rs ignores keys it does
// not handle when read-only).
export component ReplyText inherits FocusScope {
    in property <string> text;
    property <bool> focused: input.has-focus;
    VerticalLayout {
        input := SelectableText {
            text: root.text;
            font-size: Theme.font-m;
        }
    }
    key-pressed(event) => {
        if event.text == Key.Escape {
            ReplySelect.item = -1;
            return accept;
        }
        return reject;
    }
    changed focused => {
        if !self.focused { ReplySelect.item = -1; }
    }
    init => {
        input.focus();
        input.select-all();
        ReplySelect.drawn = input.text;
    }
}