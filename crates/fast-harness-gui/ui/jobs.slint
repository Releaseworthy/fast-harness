import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { PopTab, PopoverCard } from "pill.slint";
import { JobsUi, JobItem } from "job_row.slint";
export { JobsUi }

// "Finished N" with its chevron, and Clear (the rows leave the list only).
component FinishedHeader inherits Rectangle {
    height: 26px;
    accessible-role: button;
    accessible-label: (JobsUi.finished-open ? "Hide " : "Show ") + JobsUi.finished.length + " finished jobs";
    accessible-action-default => { JobsUi.finished-open = !JobsUi.finished-open; }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { JobsUi.finished-open = !JobsUi.finished-open; }
    }
    HorizontalLayout {
        padding-left: Theme.space-xs;
        spacing: Theme.space-s;
        Mark {
            text: JobsUi.finished-open ? Icons.chevron-down : Icons.chevron-right;
            color: Theme.dim;
            font-size: Theme.font-xs;
        }
        Text {
            text: "Finished " + JobsUi.finished.length;
            color: ta.has-hover ? Theme.text : Theme.dim;
            font-size: Theme.font-xs;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: clear.preferred-width + 2 * Theme.space-s;
            border-radius: Theme.radius-s;
            background: clear-ta.has-hover ? Theme.hover : transparent;
            accessible-role: button;
            accessible-label: "Clear the finished jobs from the list";
            accessible-action-default => { JobsUi.clear(); }
            clear := Text {
                text: "Clear";
                color: Theme.accent;
                font-size: Theme.font-xs;
                vertical-alignment: center;
            }
            clear-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { JobsUi.clear(); }
            }
        }
    }
}

// The popover's sections: Running, then Finished N (collapsible). `hi`
// is the row the arrow keys moved to, counting running rows first.
component JobsList inherits VerticalLayout {
    in property <int> hi;
    padding: Theme.space-s;
    spacing: 2px;
    accessible-role: list;
    accessible-label: "Background jobs";
    if JobsUi.running.length > 0: Text {
        text: "Running";
        color: Theme.dim;
        font-size: Theme.font-xs;
        font-weight: 600;
    }
    for j[i] in JobsUi.running: JobItem {
        job: j;
        highlighted: i == root.hi;
    }
    if JobsUi.finished.length > 0: FinishedHeader {}
    if JobsUi.finished-open: VerticalLayout {
        spacing: 2px;
        for j[i] in JobsUi.finished: JobItem {
            job: j;
            highlighted: JobsUi.running.length + i == root.hi;
        }
    }
}

// The shown session's background jobs (PLAN.md D72, D76): a tab after
// Trace (and Subagents), "Jobs 2" with a running dot while one runs; a
// click opens the popover under it. Escape or a click outside closes it.
// TabStrip (panel.slint) shows it only while `JobsUi.count > 0`.
export component JobsTab inherits Rectangle {
    // The height the popover may take, and its width at most.
    in property <length> room: 480px;
    in property <length> span: 560px;
    property <bool> open: JobsUi.open;
    property <int> hi: -1;
    width: tab.width;
    // A tab that comes back starts closed (its popover went with it).
    init => { JobsUi.open = false; }
    changed open => {
        if root.open {
            root.hi = -1;
            popup.show();
        } else {
            popup.close();
        }
    }
    tab := PopTab {
        height: root.height;
        icon: Icons.terminal;
        text: "Jobs";
        count: JobsUi.count;
        running: JobsUi.running.length > 0;
        label: "Background jobs: " + JobsUi.count + (JobsUi.running.length > 0 ? ", " + JobsUi.running.length + " running" : "");
        open: root.open;
        toggle => { JobsUi.open = !JobsUi.open; }
        show => { JobsUi.open = true; }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: min(root.span, 560px);
        height: min(list.preferred-height + 2px, root.room);
        close-policy: close-on-click-outside;
        forward-focus: keys;
        keys := FocusScope {
            // The scope holds the focus while the popover is open and loses
            // it however the popover closes (Esc, a click outside).
            focus-changed-event => {
                if !self.has-focus {
                    JobsUi.open = false;
                    JobsUi.confirm = "";
                    JobsUi.closed();
                }
            }
            key-pressed(event) => { return root.list-keys(event); }
        }
        PopoverCard {
            Flickable {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: parent.height - 2px;
                content-height: list.preferred-height;
                list := JobsList { width: parent.width; hi: root.hi; }
            }
        }
    }

    // Up and Down move between the rows, Enter shows or hides the output.
    function list-keys(event: KeyEvent) -> EventResult {
        let rows = JobsUi.running.length + (JobsUi.finished-open ? JobsUi.finished.length : 0);
        if event.text == Key.DownArrow {
            root.hi = min(rows - 1, root.hi + 1);
            return accept;
        }
        if event.text == Key.UpArrow {
            root.hi = max(0, root.hi - 1);
            return accept;
        }
        if event.text == Key.Return && root.hi >= 0 {
            JobsUi.expand(root.hi < JobsUi.running.length ? JobsUi.running[root.hi].id
                : JobsUi.finished[root.hi - JobsUi.running.length].id);
            return accept;
        }
        if event.text == Key.Escape {
            popup.close();
            return accept;
        }
        return reject;
    }
}
