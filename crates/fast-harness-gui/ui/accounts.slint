import { ScrollView } from "std-widgets.slint";
import { AccountRow, GoogleRow, ProviderCard } from "types.slint";
import { GoogleSection } from "google.slint";
import { ClientForm } from "google_client.slint";
import { ProviderGrid, ProviderHeader } from "providers.slint";
import { Theme, UsageBar, Badge, Columns, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, KeyInput } from "widgets.slint";
import { MarkLine } from "blocks.slint";

component AccountCard inherits Rectangle {
    in property <AccountRow> info;
    callback use(string);
    callback remove(string);
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: info.active ? Theme.accent : Theme.line;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-l - 2px;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            Text {
                text: info.name;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            VerticalLayout { alignment: center; Badge { text: info.kind; height: 20px; } }
            if info.plan != "": VerticalLayout { alignment: center; Badge { text: info.plan; height: 20px; } }
            if info.active: VerticalLayout { alignment: center; Badge { text: "Active"; strong: true; height: 20px; } }
            Rectangle { horizontal-stretch: 1; }
            if !info.active: ActionButton {
                icon: Icons.check;
                text: "Use";
                clicked => { root.use(info.id); }
            }
            ActionButton {
                icon: Icons.trash;
                text: "Remove";
                variant: "ghost";
                clicked => { root.remove(info.id); }
            }
        }
        UsageBar { label: "5h"; value: info.five; caption: info.five-text; }
        UsageBar { label: "7d"; value: info.seven; caption: info.seven-text; }
        if info.hold != "": MarkLine { icon: Icons.debug-pause; tint: Theme.warning; text: info.hold; }
        if !info.token-ok: HorizontalLayout {
            spacing: Theme.space-s;
            Mark { text: Icons.error; color: Theme.error; font-size: Theme.font-s; }
            Text { text: "Token rejected: sign in again."; color: Theme.error; font-size: Theme.font-s; horizontal-stretch: 1; }
        }
    }
}

// Shown while a sign-in waits for the browser callback.
component LoginWait inherits Rectangle {
    in property <string> url;
    callback open-url(string);
    callback copy(string);
    callback cancel();
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.warning;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-l - 2px;
        spacing: Theme.space-s;
        Text {
            text: "Waiting for the sign-in in the browser. If no page opened, visit:";
            color: Theme.text;
            wrap: word-wrap;
        }
        KeyInput { text: root.url; read-only: true; placeholder: "Sign-in URL"; }
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            ActionButton { icon: Icons.link-external; text: "Open again"; variant: "primary"; clicked => { root.open-url(root.url); } }
            ActionButton { icon: Icons.copy; text: "Copy URL"; clicked => { root.copy(root.url); } }
            ActionButton { text: "Cancel"; variant: "ghost"; clicked => { root.cancel(); } }
        }
    }
}

component KeyForm inherits Rectangle {
    callback save(string, string);
    callback cancel();
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.surface;
    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        label-edit := KeyInput { placeholder: "Label (optional)"; width: 180px; }
        key-edit := KeyInput {
            placeholder: "API key";
            password: true;
            horizontal-stretch: 1;
            accepted => { save.clicked(); }
        }
        save := ActionButton {
            text: "Save";
            variant: "primary";
            clicked => {
                root.save(key-edit.text, label-edit.text);
                key-edit.text = "";
            }
        }
        ActionButton { text: "Cancel"; variant: "ghost"; clicked => { key-edit.text = ""; root.cancel(); } }
    }
}

// Opens on the provider cards (`provider` empty); a card opens that
// provider's page, Back or Esc returns to the cards (PLAN.md D32).
export component AccountsPage inherits Rectangle {
    in property <[AccountRow]> accounts;
    in property <string> login-url;
    in property <string> message;
    in property <bool> working;
    in-out property <bool> adding-key;
    callback sign-in();
    callback cancel-sign-in();
    callback add-key(string, string);
    callback refresh();
    callback use(string);
    callback remove(string);
    callback open-url(string);
    callback copy(string);
    in property <[GoogleRow]> google-accounts;
    callback google-sign-in();
    callback google-use(string);
    callback google-remove(string);
    in property <[ProviderCard]> providers;
    // "" (the cards), "claude" or "google".
    in-out property <string> provider;
    in property <bool> client-ready;
    in property <string> client-id;
    in property <string> client-note;
    in property <bool> client-error;
    callback save-client(string, string);
    property <ProviderCard> current: root.providers[root.provider == "google" ? 1 : 0];
    function open(id: string) {
        root.provider = id;
        fs.focus();
    }
    function back() {
        root.provider = "";
        root.adding-key = false;
        fs.focus();
    }
    background: transparent;
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape && root.provider != "" {
                root.back();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding-top: Theme.space-xl;
            padding-bottom: Theme.space-l;
            padding-left: Columns.side(root.width, Theme.column-width);
            padding-right: Columns.side(root.width, Theme.column-width);
            spacing: Theme.space-m;
            if root.provider == "": HorizontalLayout {
                spacing: Theme.space-s;
                VerticalLayout {
                    spacing: 2px;
                    Text { text: "Accounts"; color: Theme.text; font-size: Theme.font-l; font-weight: 600; }
                    Text { text: "Pick a provider to manage its accounts."; color: Theme.dim; font-size: Theme.font-s; }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    ActionButton { icon: Icons.refresh; text: "Refresh usage"; enabled: !root.working; clicked => { root.refresh(); } }
                }
            }
            if root.provider != "": ProviderHeader {
                info: root.current;
                back => { root.back(); }
                if root.provider == "claude": ActionButton { icon: Icons.sign-in; text: "Sign in"; variant: "primary"; enabled: root.login-url == ""; clicked => { root.sign-in(); } }
                if root.provider == "claude": ActionButton { icon: Icons.key; text: "Add API key"; clicked => { root.adding-key = true; } }
                if root.provider == "claude": ActionButton { icon: Icons.refresh; text: "Refresh usage"; enabled: !root.working; clicked => { root.refresh(); } }
                if root.provider == "google": ActionButton { icon: Icons.sign-in; text: "Add Google account"; variant: "primary"; enabled: root.login-url == ""; clicked => { root.google-sign-in(); } }
            }
            if root.message != "": Text { text: root.message; wrap: word-wrap; color: Theme.dim; font-size: Theme.font-s; }
            if root.login-url != "": LoginWait {
                url: root.login-url;
                open-url(u) => { root.open-url(u); }
                copy(u) => { root.copy(u); }
                cancel => { root.cancel-sign-in(); }
            }
            if root.provider == "claude" && root.adding-key: KeyForm {
                save(k, l) => { root.add-key(k, l); }
                cancel => { root.adding-key = false; }
            }
            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                    spacing: Theme.space-s + 2px;
                    if root.provider == "": ProviderGrid {
                        cards: root.providers;
                        open(id) => { root.open(id); }
                    }
                    if root.provider == "claude" && root.accounts.length == 0: Text {
                        text: "No Claude account yet: sign in or add an API key.";
                        color: Theme.dim;
                        wrap: word-wrap;
                    }
                    if root.provider == "claude": VerticalLayout {
                        spacing: Theme.space-s + 2px;
                        for a in root.accounts: AccountCard {
                            info: a;
                            use(id) => { root.use(id); }
                            remove(id) => { root.remove(id); }
                        }
                    }
                    if root.provider == "google": ClientForm {
                        ready: root.client-ready;
                        saved-id: root.client-id;
                        note: root.client-note;
                        error: root.client-error;
                        save(id, secret) => { root.save-client(id, secret); }
                    }
                    if root.provider == "google": GoogleSection {
                        accounts: root.google-accounts;
                        use(id) => { root.google-use(id); }
                        remove(id) => { root.google-remove(id); }
                        open-url(u) => { root.open-url(u); }
                    }
                }
            }
        }
    }
}