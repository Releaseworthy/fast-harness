import { ListView } from "std-widgets.slint";
import { AccountRow } from "types.slint";
import { Theme, UsageBar, Badge, Columns, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, KeyInput } from "widgets.slint";

component AccountCard inherits Rectangle {
    in property <AccountRow> info;
    callback use(string);
    callback remove(string);
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: info.active ? Theme.accent : Theme.line;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-l - 2px;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            Text {
                text: info.name;
                color: Theme.text;
                font-size: Theme.font-m;
                font-weight: 600;
                overflow: elide;
                vertical-alignment: center;
            }
            VerticalLayout { alignment: center; Badge { text: info.kind; height: 20px; } }
            if info.plan != "": VerticalLayout { alignment: center; Badge { text: info.plan; height: 20px; } }
            if info.active: VerticalLayout { alignment: center; Badge { text: "Active"; strong: true; height: 20px; } }
            Rectangle { horizontal-stretch: 1; }
            if !info.active: ActionButton {
                icon: Icons.check;
                text: "Use";
                clicked => { root.use(info.id); }
            }
            ActionButton {
                icon: Icons.trash;
                text: "Remove";
                variant: "ghost";
                clicked => { root.remove(info.id); }
            }
        }
        UsageBar { label: "5h"; value: info.five; caption: info.five-text; }
        UsageBar { label: "7d"; value: info.seven; caption: info.seven-text; }
        if info.hold != "": HorizontalLayout {
            spacing: Theme.space-s;
            Mark { text: Icons.debug-pause; color: Theme.warning; font-size: Theme.font-s; }
            Text { text: info.hold; color: Theme.warning; font-size: Theme.font-s; wrap: word-wrap; horizontal-stretch: 1; }
        }
        if !info.token-ok: HorizontalLayout {
            spacing: Theme.space-s;
            Mark { text: Icons.error; color: Theme.error; font-size: Theme.font-s; }
            Text { text: "Token rejected: sign in again."; color: Theme.error; font-size: Theme.font-s; horizontal-stretch: 1; }
        }
    }
}

// Shown while a sign-in waits for the browser callback.
component LoginWait inherits Rectangle {
    in property <string> url;
    callback open-url(string);
    callback copy(string);
    callback cancel();
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.warning;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-l - 2px;
        spacing: Theme.space-s;
        Text {
            text: "Waiting for the sign-in in the browser. If no page opened, visit:";
            color: Theme.text;
            wrap: word-wrap;
        }
        KeyInput { text: root.url; read-only: true; placeholder: "Sign-in URL"; }
        HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            ActionButton { icon: Icons.link-external; text: "Open again"; variant: "primary"; clicked => { root.open-url(root.url); } }
            ActionButton { icon: Icons.copy; text: "Copy URL"; clicked => { root.copy(root.url); } }
            ActionButton { text: "Cancel"; variant: "ghost"; clicked => { root.cancel(); } }
        }
    }
}

component KeyForm inherits Rectangle {
    callback save(string, string);
    callback cancel();
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.surface;
    HorizontalLayout {
        padding: Theme.space-m;
        spacing: Theme.space-s;
        label-edit := KeyInput { placeholder: "Label (optional)"; width: 180px; }
        key-edit := KeyInput {
            placeholder: "API key";
            password: true;
            horizontal-stretch: 1;
            accepted => { save.clicked(); }
        }
        save := ActionButton {
            text: "Save";
            variant: "primary";
            clicked => {
                root.save(key-edit.text, label-edit.text);
                key-edit.text = "";
            }
        }
        ActionButton { text: "Cancel"; variant: "ghost"; clicked => { key-edit.text = ""; root.cancel(); } }
    }
}

export component AccountsPage inherits Rectangle {
    in property <[AccountRow]> accounts;
    in property <string> login-url;
    in property <string> message;
    in property <bool> working;
    in-out property <bool> adding-key;
    callback sign-in();
    callback cancel-sign-in();
    callback add-key(string, string);
    callback refresh();
    callback use(string);
    callback remove(string);
    callback open-url(string);
    callback copy(string);
    background: Theme.bg;
    VerticalLayout {
        padding-top: Theme.space-xl;
        padding-bottom: Theme.space-l;
        padding-left: Columns.side(root.width, Theme.column-width);
        padding-right: Columns.side(root.width, Theme.column-width);
        spacing: Theme.space-m;
        HorizontalLayout {
            spacing: Theme.space-s;
            Text {
                text: "Accounts";
                color: Theme.text;
                font-size: Theme.font-l;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            ActionButton { icon: Icons.sign-in; text: "Sign in"; variant: "primary"; enabled: root.login-url == ""; clicked => { root.sign-in(); } }
            ActionButton { icon: Icons.key; text: "Add API key"; clicked => { root.adding-key = true; } }
            ActionButton { icon: Icons.refresh; text: "Refresh usage"; enabled: !root.working; clicked => { root.refresh(); } }
        }
        if root.message != "": Text { text: root.message; wrap: word-wrap; color: Theme.dim; font-size: Theme.font-s; }
        if root.login-url != "": LoginWait {
            url: root.login-url;
            open-url(u) => { root.open-url(u); }
            copy(u) => { root.copy(u); }
            cancel => { root.cancel-sign-in(); }
        }
        if root.adding-key: KeyForm {
            save(k, l) => { root.add-key(k, l); }
            cancel => { root.adding-key = false; }
        }
        if root.accounts.length == 0: Text {
            text: "No account yet: sign in or add an API key.";
            color: Theme.dim;
            wrap: word-wrap;
        }
        ListView {
            vertical-stretch: 1;
            for a in root.accounts: VerticalLayout {
                padding-bottom: Theme.space-s + 2px;
                AccountCard {
                    info: a;
                    use(id) => { root.use(id); }
                    remove(id) => { root.remove(id); }
                }
            }
        }
    }
}
