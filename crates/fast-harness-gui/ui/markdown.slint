// A reply's markdown blocks (src/md_blocks.rs, the owner 2026-11-15):
// headings larger, list items after their marker, code in a monospace box,
// a quote with a bar on the left, a rule, a table as a grid. Every part
// that holds wrapped text is a component (ui/blocks.slint, slint#13655), so
// a row measures its real height for the chat's virtual list.
import { Theme } from "parts.slint";
import { CodeBox } from "blocks.slint";
import { Ghost, CrossSelect } from "selectable.slint";
import { MdBlock, MdRow, MdCell } from "types.slint";

// Inline markdown, wrapped. StyledText takes every press (i-slint-core
// 1.18.1 items/text.rs), so a block with `plain` text is selected through
// a Ghost of that text (ui/selectable.slint) while hovered or focused; the
// ghost takes a link's click too, so it opens the link itself (`links`,
// ui/cross_select.slint `armed`). Plain text can wrap apart from the styled one (bold, code), so
// while the ghost holds a selection it draws its own text and the
// StyledText hides; otherwise the ghost is transparent.
component MdText inherits TouchArea {
    in property <styled-text> text;
    in property <string> plain;
    in property <length> size: Theme.font-m;
    in property <int> weight: 400;
    // Its place in the chat's selection (ui/cross_select.slint); a block
    // with no plain text has no ghost, so it stays out (row -1).
    in property <int> sel-row: -1;
    in property <int> idx;
    in property <string> links;
    in property <string> sep: "\n";
    // A table cell: its row's cells share their y range, so a drag enters
    // it by x too.
    in property <bool> by-x;
    callback link(string);
    property <bool> focused;
    property <bool> selecting;
    property <int> group: root.plain != "" ? root.sel-row : -1;
    // The ghost exists; a block that leaves the selection (a Shift+click
    // that shrinks it) loses its ghost without a `changed selecting`, so
    // `selecting` can be stale and the text hides only while it shows.
    property <bool> shown: root.plain != "" && (root.has-hover || root.focused || CrossSelect.within(root.group, root.idx));
    property <bool> inked: root.selecting && root.shown;
    property <bool> over: CrossSelect.over(root.group, self.absolute-position.y, self.height) && (!root.by-x || CrossSelect.beside(self.absolute-position.x, self.width));
    function track() {
        CrossSelect.track(root.group, root.idx, self.absolute-position.x, self.absolute-position.y, self.width, self.height, self.mouse-x, self.mouse-y);
    }
    changed mouse-x => { root.track(); }
    changed mouse-y => { root.track(); }
    changed over => {
        if self.over {
            CrossSelect.reach(root.group, root.idx, clamp(CrossSelect.px, self.absolute-position.x + 2px, self.absolute-position.x + max(2px, self.width - 2px)), clamp(CrossSelect.py, self.absolute-position.y + 1px, self.absolute-position.y + max(1px, self.height - 1px)));
        }
    }
    VerticalLayout {
        label := StyledText {
            text: root.text;
            default-color: Theme.text;
            default-font-size: root.size;
            link-color: Theme.accent;
            opacity: root.inked ? 0 : 1;
            link-clicked(url) => { root.link(url); }
        }
    }
    if root.shown: Ghost {
        x: label.x;
        y: label.y;
        width: label.width;
        height: label.height;
        text: root.plain;
        font-size: root.size;
        font-weight: root.weight;
        ink: root.inked;
        sel-row: root.group;
        idx: root.idx;
        links: root.links;
        sep: root.sep;
        init => {
            root.focused = self.has-focus;
            root.selecting = self.selecting;
        }
        changed has-focus => { root.focused = self.has-focus; }
        changed selecting => { root.selecting = self.selecting; }
    }
}

// A list item: its marker (bullet, number or task box) and its text.
component MdItem inherits Rectangle {
    in property <MdBlock> block;
    in property <int> sel-row: -1;
    in property <int> idx;
    callback link(string);
    HorizontalLayout {
        spacing: 4px;
        Text {
            width: 22px;
            text: root.block.marker;
            color: Theme.dim;
            font-size: Theme.font-m;
            horizontal-alignment: right;
        }
        MdText {
            text: root.block.text;
            plain: root.block.plain;
            links: root.block.links;
            sel-row: root.sel-row;
            idx: root.idx;
            link(url) => { root.link(url); }
        }
    }
}

// A thematic break.
component MdRule inherits Rectangle {
    height: Theme.space-m;
    Rectangle {
        y: (parent.height - 1px) / 2;
        height: 1px;
        background: Theme.line;
    }
}

// One table cell: its column's share of the width, a line on its right.
component MdCellView inherits Rectangle {
    in property <MdCell> cell;
    in property <int> sel-row: -1;
    in property <int> idx;
    in property <string> sep;
    callback link(string);
    HorizontalLayout {
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        padding-top: Theme.space-xs;
        padding-bottom: Theme.space-xs;
        MdText {
            text: root.cell.text;
            plain: root.cell.plain;
            links: root.cell.links;
            sel-row: root.sel-row;
            idx: root.idx;
            sep: root.sep;
            by-x: true;
            size: Theme.font-s;
            link(url) => { root.link(url); }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Theme.line;
    }
}

// One table row: the header tinted, every other body row striped.
// `base` is its first cell's place in the chat's selection; cells copy
// tab-separated, a row per line.
component MdRowView inherits Rectangle {
    in property <MdRow> data;
    in property <int> sel-row: -1;
    in property <int> base;
    callback link(string);
    background: root.data.head ? Theme.code : root.data.odd ? Theme.hover.with-alpha(0.5) : transparent;
    HorizontalLayout {
        for cell[c] in root.data.cells: MdCellView {
            sel-row: root.sel-row;
            idx: root.base + c;
            sep: c > 0 ? "\u{9}" : "\n";
            // Widths by column share: nothing preferred, stretched by share.
            min-width: 0px;
            preferred-width: 0px;
            horizontal-stretch: cell.share;
            cell: cell;
            link(url) => { root.link(url); }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

// A table: rows of cells sized by their column's share, a frame around.
// A table's cells follow its block (`idx`) in the chat's selection: row r,
// column c at idx + 1 + r * 256 + c (MdReply leaves 65536 per block).
component MdTable inherits Rectangle {
    in property <[MdRow]> rows;
    in property <int> sel-row: -1;
    in property <int> idx;
    callback link(string);
    border-radius: Theme.radius-s;
    VerticalLayout {
        for row[r] in root.rows: MdRowView {
            data: row;
            sel-row: root.sel-row;
            base: root.idx + 1 + r * 256;
            link(url) => { root.link(url); }
        }
    }
    Rectangle {
        border-width: 1px;
        border-color: Theme.line;
        border-radius: Theme.radius-s;
    }
}

// One block: indented by its list depth, a bar per quote level.
export component MdBlockView inherits Rectangle {
    in property <MdBlock> block;
    in property <int> sel-row: -1;
    in property <int> idx;
    callback link(string);
    property <bool> quoted: root.block.quote > 0;
    HorizontalLayout {
        // An item's marker sits in its level's indent; a code block or a
        // second paragraph of an item lines up with the item's text.
        padding-left: root.block.kind == "li" ? max(0, root.block.indent - 1) * 26px : root.block.indent * 26px;
        spacing: root.quoted ? Theme.space-m : 0px;
        Rectangle {
            width: root.quoted ? 3px : 0px;
            background: Theme.dim.with-alpha(0.35);
        }
        VerticalLayout {
            padding-top: root.block.kind == "h" ? Theme.space-xs : 0px;
            if root.block.kind == "p": MdText {
                text: root.block.text;
                plain: root.block.plain;
                links: root.block.links;
                sel-row: root.sel-row;
                idx: root.idx;
                link(url) => { root.link(url); }
            }
            if root.block.kind == "h": MdText {
                text: root.block.text;
                plain: root.block.plain;
                links: root.block.links;
                sel-row: root.sel-row;
                idx: root.idx;
                weight: 700;
                size: root.block.level <= 1 ? Theme.font-xl : root.block.level == 2 ? Theme.font-l : root.block.level == 3 ? 16px : Theme.font-m;
                link(url) => { root.link(url); }
            }
            if root.block.kind == "li": MdItem {
                block: root.block;
                sel-row: root.sel-row;
                idx: root.idx;
                link(url) => { root.link(url); }
            }
            if root.block.kind == "code": CodeBox { text: root.block.code; sel-row: root.sel-row; idx: root.idx; }
            if root.block.kind == "rule": MdRule { }
            if root.block.kind == "table": MdTable {
                rows: root.block.rows;
                sel-row: root.sel-row;
                idx: root.idx;
                link(url) => { root.link(url); }
            }
        }
    }
}

// A reply: its blocks in order.
export component MdReply inherits Rectangle {
    in property <[MdBlock]> blocks;
    // The transcript item, for the chat's selection; block i is at
    // i * 65536, room for a table's cells after it (MdTable).
    in property <int> sel-row: -1;
    callback link(string);
    VerticalLayout {
        spacing: Theme.space-s;
        for block[i] in root.blocks: MdBlockView {
            block: block;
            sel-row: root.sel-row;
            idx: i * 65536;
            link(url) => { root.link(url); }
        }
    }
}
