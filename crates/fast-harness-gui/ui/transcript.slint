import { ListView } from "std-widgets.slint";
import { MsgRow } from "types.slint";
import { Theme, LinkText, Columns, Mark, AccentFill, Elevation, Card, Halo } from "parts.slint";
import { Icons } from "icons.slint";
import { BusySpinner, IconButton } from "widgets.slint";
import { ScrollBar } from "scrollbar.slint";
import { ThinkingQuote, LoadingLine } from "blocks.slint";
import { ToolFrame } from "toolcard.slint";
import { RowThumbs } from "attach.slint";
import { StepLine, StepRail, Rails } from "stepline.slint";
import { TurnNav, TurnsUi } from "turnnav.slint";

// The user's message: a bubble on the right, at most 80% of the column.
component UserBubble {
    in property <MsgRow> msg;
    callback copy(string);
    VerticalLayout {
        spacing: Theme.space-xs;
        HorizontalLayout {
            alignment: end;
            // The bubble: rounded, with a tighter corner at the bottom right.
            Rectangle {
                max-width: root.width * 0.8;
                border-top-left-radius: Theme.radius-xl;
                border-top-right-radius: Theme.radius-xl;
                border-bottom-left-radius: Theme.radius-xl;
                border-bottom-right-radius: Theme.radius-s - 2px;
                background: Theme.bubble;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.35);
                HorizontalLayout {
                    padding-left: Theme.space-l - 2px;
                    padding-right: Theme.space-l - 2px;
                    padding-top: Theme.space-s + 2px;
                    padding-bottom: Theme.space-s + 2px;
                    VerticalLayout {
                        spacing: Theme.space-xs;
                        if msg.images.length > 0: RowThumbs { images: msg.images; }
                        Text {
                            text: msg.shown;
                            wrap: word-wrap;
                            color: Theme.text;
                            font-size: Theme.font-m;
                        }
                    }
                }
            }
        }
        LinkText {
            text: "Copy";
            horizontal-alignment: right;
            clicked => { root.copy(msg.text); }
        }
    }
}

component AssistantBlock {
    in property <MsgRow> msg;
    // The step is folded (D73): the text stays, the thinking goes.
    property <bool> thinking: msg.thinking != "" && !msg.folded;
    callback copy(string);
    callback toggle();
    callback link(string);
    VerticalLayout {
        spacing: Theme.space-s;
        // Show thinking. No speaker tile or name: no logo or "Fast Harness"
        // inside the chat (the owner, 2026-11-14).
        if root.thinking: HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            if root.thinking: Mark { text: msg.expanded ? Icons.chevron-down : Icons.chevron-right; color: Theme.dim; font-size: Theme.font-s; }
            if root.thinking: LinkText {
                text: msg.expanded ? "Hide thinking" : "Show thinking";
                font-size: Theme.font-s;
                vertical-alignment: center;
                clicked => { root.toggle(); }
            }
        }
        // Wrapped text under an `if` sits in a component (ui/blocks.slint).
        if root.thinking && msg.expanded: ThinkingQuote { text: msg.thinking; }
        if msg.text != "": StyledText {
            text: msg.body;
            default-color: Theme.text;
            default-font-size: Theme.font-m;
            link-color: Theme.accent;
            link-clicked(url) => { root.link(url); }
        }
        if msg.text != "": LinkText {
            text: "Copy";
            clicked => { root.copy(msg.text); }
        }
    }
}

// A note line: a mark per kind (refresh: retry, git-compare: switch, error, info).
component Note {
    in property <MsgRow> msg;
    property <color> tint: msg.tone == "error" ? Theme.error : msg.tone == "retry" ? Theme.warning : msg.tone == "switch" ? Theme.accent : Theme.dim;
    HorizontalLayout {
        spacing: Theme.space-s;
        Mark {
            width: 14px;
            vertical-alignment: top;
            horizontal-alignment: center;
            text: msg.tone == "retry" ? Icons.refresh : msg.tone == "switch" ? Icons.git-compare : msg.tone == "error" ? Icons.error : Icons.info;
            color: root.tint;
            font-size: Theme.font-m;
        }
        Text {
            text: msg.shown;
            wrap: word-wrap;
            font-size: Theme.font-s;
            color: root.tint;
        }
    }
}

// One row. A step's first row carries its line (D73); the rows of an open
// step sit indented right of the rail, and a folded row draws nothing.
component MessageView {
    in property <MsgRow> msg;
    callback copy(string);
    callback toggle();
    callback link(string);
    callback step-toggle(int);
    callback turn-toggle(int);
    // The row's index in the transcript (`item`).
    in property <int> row-index;
    // The empty space at the end while the session popup shows (D81).
    in property <length> pad;
    property <bool> spacer: msg.kind == "spacer";
    property <length> side: Columns.chat(root.width);
    // D80: the rows of a turn sit 20px in, right of the turn's rail; the
    // rows of an open step 20px more, right of the step's rail.
    property <length> indent: msg.turn-rail ? 20px : 0px;
    property <bool> turn-line: msg.turn-line != "";
    // The row's own content draws: not inside a folded turn.
    property <bool> shown: !msg.turn-hidden;
    property <bool> line: msg.step-summary != "" && !msg.turn-hidden;
    property <bool> blank: root.spacer || msg.turn-hidden ? !root.turn-line : msg.folded && !root.line && (msg.kind != "assistant" || msg.text == "");
    property <length> top: root.blank || msg.kind == "footer" ? 0px : msg.kind == "user" ? Theme.space-l : Theme.space-s;
    property <length> line-height: root.line ? 26px + Theme.space-xs : 0px;
    VerticalLayout {
        padding-left: root.side + root.indent;
        padding-right: root.side;
        padding-top: root.top;
        // A tool card keeps room for its elevation above the step line.
        padding-bottom: root.blank ? 0px : msg.kind == "footer" ? Theme.space-s : msg.kind == "tool" && !msg.folded ? Theme.space-s + 2px : 2px;
        spacing: Theme.space-xs;
        if root.turn-line: StepLine {
            text: msg.turn-line;
            label: "Turn " + msg.turn-no + " folded: " + msg.turn-line;
            open: false;
            toggled => { root.turn-toggle(msg.turn-head); }
        }
        if root.line: StepLine {
            text: msg.step-summary;
            label: msg.step-label;
            open: msg.step-open;
            running: msg.step-running;
            failed: msg.step-failed;
            toggled => { root.step-toggle(msg.step-head); }
        }
        // A folded turn's rows build no content at all: `visible: false`
        // with `max-height: 0` kept each row's min height (wrapped text
        // wins over max-height), so the rows after the fold drew blank
        // (D80, 2026-11-14). The parts are components, so `if` is safe
        // from slint#13655.
        VerticalLayout {
            padding-left: msg.rail ? 20px : 0px;
            if root.shown && msg.kind == "user": UserBubble {
                msg: msg;
                copy(t) => { root.copy(t); }
            }
            if root.shown && msg.kind == "assistant": AssistantBlock {
                msg: msg;
                copy(t) => { root.copy(t); }
                toggle => { root.toggle(); }
                link(u) => { root.link(u); }
            }
            if root.shown && msg.kind == "tool" && !msg.folded: ToolFrame {
                tool: msg.tool;
                error: msg.error;
                not-run: msg.not-run;
                expanded: msg.expanded;
                toggle => { root.toggle(); }
                status: true;
                running: msg.running;
                live: msg.live;
                approval: msg.approval;
                copy => { root.copy(msg.text); }
            }
            if root.shown && msg.kind == "note": Note { msg: msg; }
            if root.spacer: Rectangle { height: root.pad; }
            if root.shown && msg.kind == "footer" && !msg.folded: Text {
                text: msg.text;
                font-size: Theme.font-xs;
                color: Theme.dim;
                overflow: elide;
            }
        }
    }
    // The rail runs the row's whole height below its step line, so the
    // rows of an open step join into one line.
    if msg.turn-rail: StepRail {
        label: "Collapse turn " + msg.turn-no;
        x: root.side;
        // A small gap above the turn's first row.
        y: msg.turn-head == root.row-index ? root.top : 0px;
        height: root.height - self.y;
        lit: Rails.turn == msg.turn-head;
        changed hovered => {
            Rails.turn = self.hovered ? msg.turn-head : Rails.turn == msg.turn-head ? -1 : Rails.turn;
        }
        clicked => { root.turn-toggle(msg.turn-head); }
    }
    if msg.rail && !msg.turn-hidden: StepRail {
        x: root.side + root.indent;
        y: root.line ? root.top + root.line-height : 0px;
        height: root.height - self.y;
        lit: Rails.step == msg.step-head;
        changed hovered => {
            Rails.step = self.hovered ? msg.step-head : Rails.step == msg.step-head ? -1 : Rails.step;
        }
        clicked => { root.step-toggle(msg.step-head); }
    }
}
// The transcript list (2026-11-14): its own virtual list (src/chat_list.rs),
// not Slint's ListView, whose content height was the average height of the
// rows it had laid out times the row count: the thumb changed size, a drag
// jumped and a fold moved the view. Rust measures every row once through
// `probe` (a hidden copy of a row at the list's width) and gives `tops`
// (each row's top, the last one the content height), `slots` (the rows in
// and around the view) and `offset` (the scroll position); this view draws
// those rows at their tops and asks Rust to `sync` when the rows, the size
// or the scroll change. It follows the end while `follow` is true: a user
// scroll (the wheel, the themed bar) clears it, arriving at the end sets
// it again, "Jump to latest" does it in one click.
export component TranscriptView {
    in property <[MsgRow]> rows;
    // A session's log is opening on a worker (D60): the list says so in a
    // word, above the rows shown until its result comes.
    in property <bool> loading;
    in-out property <bool> follow: true;
    // Empty space after the last row while the session popup shows (D81):
    // the height of the "spacer" row Rust appends then, so the list keeps
    // its full height and its last real row ends at the popup's top.
    in property <length> pad;
    // From src/chat_list.rs: the list rows to draw, every row's top and the
    // end, the scroll position, and the row to measure.
    in property <[int]> slots;
    in property <[length]> tops;
    in-out property <length> offset;
    in property <MsgRow> probe-row;
    out property <length> probe-height: probe.preferred-height;
    // The row the tests watch (its `item`) and its top in the view.
    in property <int> watch-item: -1;
    in-out property <length> watch-y;
    callback sync();
    // A row's toggle is about to run: the row (list index), the step's or
    // turn's head, a turn's or not; Rust keeps the row in place.
    callback anchor(int, int, bool);
    callback go-row(int);
    callback toggle(int);
    callback turn-toggle(int);
    callback step-toggle(int);
    callback copy(string);
    callback link(string);
    property <length> total: root.tops.length > 0 ? root.tops[root.tops.length - 1] : 0px;
    property <length> max-offset: max(0px, root.total - root.height);
    property <bool> spaced: root.rows.length > 0 && root.rows[root.rows.length - 1].kind == "spacer";
    // The list's height, the bottom of its last real row, the rows' height
    // and the scroll position (for the tests).
    out property <length> list-height: root.height;
    out property <length> end-y: root.total - root.offset - (root.spaced ? root.pad : 0px);
    out property <length> content-height: root.total;
    out property <length> view-y: -root.offset;
    // The themed bar's thumb centre in window coordinates (for the tests).
    out property <length> thumb-x: bar.thumb-x;
    out property <length> thumb-y: bar.thumb-y;
    property <int> count: root.rows.length;
    property <length> font: Theme.font-m;
    // A drawn row changed: one sync for all of them.
    property <bool> stale;
    changed rows => { root.sync(); }
    changed count => { root.sync(); }
    changed pad => { root.sync(); }
    changed width => { root.sync(); }
    changed height => { root.sync(); }
    changed font => { root.sync(); }
    changed stale => {
        if root.stale {
            root.stale = false;
            root.sync();
        }
    }

    public function to-bottom() {
        root.follow = true;
        root.offset = root.max-offset;
        root.sync();
    }

    // A user scroll to `y`: it stops following, unless it arrives at the end.
    function scroll(y: length) {
        root.follow = root.offset < root.max-offset - 1px && y >= root.max-offset - 1px;
        root.offset = max(0px, min(root.max-offset, y));
        root.sync();
    }

    // The wheel over the rows (their own areas pass it on).
    TouchArea {
        scroll-event(e) => {
            root.scroll(root.offset - e.delta-y);
            return accept;
        }
    }
    Rectangle {
        clip: true;
        for slot in root.slots: MessageView {
            property <bool> watched: self.msg.item == root.watch-item;
            x: 0;
            y: root.tops[slot] - root.offset;
            width: parent.width;
            height: root.tops[slot + 1] - root.tops[slot];
            msg: root.rows[slot];
            row-index: self.msg.item;
            pad: root.pad;
            init => {
                if self.watched { root.watch-y = self.y; }
            }
            changed watched => { if self.watched { root.watch-y = self.y; } }
            changed y => { if self.watched { root.watch-y = self.y; } }
            changed msg => { root.stale = true; }
            copy(t) => { root.copy(t); }
            toggle => {
                root.anchor(slot, -1, false);
                root.toggle(self.msg.item);
                root.sync();
            }
            step-toggle(h) => {
                root.anchor(slot, h, false);
                root.step-toggle(h);
                root.sync();
            }
            turn-toggle(h) => {
                root.anchor(slot, h, true);
                root.turn-toggle(h);
                root.sync();
            }
            link(u) => { root.link(u); }
        }
    }
    // The hidden copy of a row that Rust measures: placed and sized, so it
    // never counts in the list's own size.
    Rectangle {
        x: 0;
        y: 0;
        width: 0;
        height: 0;
        probe := MessageView {
            visible: false;
            x: 0;
            y: 0;
            width: root.width;
            msg: root.probe-row;
            pad: root.pad;
            row-index: -2;
        }
    }

    bar := ScrollBar {
        x: parent.width - self.width;
        height: parent.height;
        content-y: -root.offset;
        content-height: root.total;
        visible-height: root.height;
        scroll-to(y) => { root.scroll(-y); }
    }
    // The turn navigator in the right gutter, between the column and the
    // bar; shown from two turns on, when the gutter has room for it.
    property <length> side: Columns.chat(root.width);
    property <bool> nav-shown: TurnsUi.turns.length >= 2 && root.side >= 40px;
    if root.nav-shown: TurnNav {
        x: root.width - root.side + max(4px, min(14px, (root.side - 34px) / 2));
        // Centred, clear of Jump to latest at the bottom right.
        y: 60px;
        height: max(0px, root.height - 120px);
        room: root.height;
        card-width: min(340px, root.width / 2);
        top-row: TurnsUi.top-row;
        go(row) => { root.follow = false; root.go-row(row); }
    }
    function probe() {
        TurnsUi.nav-shown = root.nav-shown;
        TurnsUi.column-right = root.absolute-position.x + root.width - root.side;
        TurnsUi.column-left = root.absolute-position.x + root.side;
        TurnsUi.list-top = root.absolute-position.y;
    }
    init => { root.probe(); }
    changed nav-shown => { root.probe(); }
    changed side => { root.probe(); }

    // The word shown while a session opens: a word, never colour only. It is
    // a component (blocks.slint), since a plain layout under an `if` measures
    // its wrapped text at its unwrapped width (pitfalls-gui). It comes after
    // the list, on an opaque strip: the rows of the session still shown
    // (scrolled to its end) drew over it and hid it (2026-11-13).
    if root.loading: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: min(parent.height, loading-line.preferred-height);
        background: Theme.surface;
        loading-line := LoadingLine {}
    }

    // Jump to latest: a round gradient button with a halo on hover.
    if !root.follow: Rectangle {
        x: parent.width - self.width - Theme.space-xl;
        y: parent.height - self.height - Theme.space-m;
        width: Theme.control-height + 4px;
        height: Theme.control-height + 4px;
        Elevation { radius: self.height / 2; level: 1.5; }
        if jump.has-hover: Halo { radius: parent.height / 2; }
        AccentFill { radius: parent.height / 2 - 1px; }
        Mark {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            text: Icons.arrow-down;
            color: Theme.on-accent;
            font-size: Theme.font-m + 2px;
        }
        jump := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.to-bottom(); }
        }
        Rectangle {
            accessible-role: button;
            accessible-label: "Jump to latest";
            accessible-action-default => { root.to-bottom(); }
        }
    }
}
