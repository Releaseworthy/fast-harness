import { ListView } from "std-widgets.slint";
import { MsgRow } from "types.slint";
import { Theme, LinkText, Columns, Mark, AccentFill, Elevation, Card, Halo } from "parts.slint";
import { Icons } from "icons.slint";
import { BusySpinner, IconButton } from "widgets.slint";
import { ScrollBar } from "scrollbar.slint";
import { ThinkingQuote, LoadingLine } from "blocks.slint";
import { ToolFrame } from "toolcard.slint";

// The user's message: a bubble on the right, at most 80% of the column.
component UserBubble {
    in property <MsgRow> msg;
    callback copy(string);
    VerticalLayout {
        spacing: Theme.space-xs;
        HorizontalLayout {
            alignment: end;
            // The bubble: rounded, with a tighter corner at the bottom right.
            Rectangle {
                max-width: root.width * 0.8;
                border-top-left-radius: Theme.radius-xl;
                border-top-right-radius: Theme.radius-xl;
                border-bottom-left-radius: Theme.radius-xl;
                border-bottom-right-radius: Theme.radius-s - 2px;
                background: Theme.bubble;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.35);
                HorizontalLayout {
                    padding-left: Theme.space-l - 2px;
                    padding-right: Theme.space-l - 2px;
                    padding-top: Theme.space-s + 2px;
                    padding-bottom: Theme.space-s + 2px;
                    Text {
                        text: msg.shown;
                        wrap: word-wrap;
                        color: Theme.text;
                        font-size: Theme.font-m;
                    }
                }
            }
        }
        LinkText {
            text: "Copy";
            horizontal-alignment: right;
            clicked => { root.copy(msg.text); }
        }
    }
}

component AssistantBlock {
    in property <MsgRow> msg;
    callback copy(string);
    callback toggle();
    callback link(string);
    VerticalLayout {
        spacing: Theme.space-s;
        // The speaker: a gradient tile with the bolt and the name.
        if msg.text != "" || msg.thinking != "": HorizontalLayout {
            spacing: Theme.space-s;
            alignment: start;
            Rectangle {
                width: 22px;
                height: 22px;
                AccentFill { radius: Theme.radius-s; }
                Mark {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    text: Icons.lightning-bolt;
                    color: Theme.on-accent;
                    font-size: Theme.font-s;
                }
            }
            Text { text: "Fast Harness"; color: Theme.text; font-size: Theme.font-s; font-weight: 700; vertical-alignment: center; }
            if msg.thinking != "": Rectangle { width: Theme.space-s; }
            if msg.thinking != "": Mark { text: msg.expanded ? Icons.chevron-down : Icons.chevron-right; color: Theme.dim; font-size: Theme.font-s; }
            if msg.thinking != "": LinkText {
                text: msg.expanded ? "Hide thinking" : "Show thinking";
                font-size: Theme.font-s;
                vertical-alignment: center;
                clicked => { root.toggle(); }
            }
        }
        // Wrapped text under an `if` sits in a component (ui/blocks.slint).
        if msg.thinking != "" && msg.expanded: ThinkingQuote { text: msg.thinking; }
        if msg.text != "": StyledText {
            text: msg.body;
            default-color: Theme.text;
            default-font-size: Theme.font-m;
            link-color: Theme.accent;
            link-clicked(url) => { root.link(url); }
        }
        if msg.text != "": LinkText {
            text: "Copy";
            clicked => { root.copy(msg.text); }
        }
    }
}

// A note line: a mark per kind (refresh: retry, git-compare: switch, error, info).
component Note {
    in property <MsgRow> msg;
    property <color> tint: msg.tone == "error" ? Theme.error : msg.tone == "retry" ? Theme.warning : msg.tone == "switch" ? Theme.accent : Theme.dim;
    HorizontalLayout {
        spacing: Theme.space-s;
        Mark {
            width: 14px;
            vertical-alignment: top;
            horizontal-alignment: center;
            text: msg.tone == "retry" ? Icons.refresh : msg.tone == "switch" ? Icons.git-compare : msg.tone == "error" ? Icons.error : Icons.info;
            color: root.tint;
            font-size: Theme.font-m;
        }
        Text {
            text: msg.shown;
            wrap: word-wrap;
            font-size: Theme.font-s;
            color: root.tint;
        }
    }
}

component MessageView {
    in property <MsgRow> msg;
    callback copy(string);
    callback toggle();
    callback link(string);
    VerticalLayout {
        padding-left: Columns.side(root.width, Theme.column-width);
        padding-right: Columns.side(root.width, Theme.column-width);
        padding-top: msg.kind == "footer" ? 0px : msg.kind == "user" ? Theme.space-l : Theme.space-s;
        // A tool card keeps room for its elevation above the step line.
        padding-bottom: msg.kind == "footer" ? Theme.space-s : msg.kind == "tool" ? Theme.space-s + 2px : 2px;
        if msg.kind == "user": UserBubble {
            msg: msg;
            copy(t) => { root.copy(t); }
        }
        if msg.kind == "assistant": AssistantBlock {
            msg: msg;
            copy(t) => { root.copy(t); }
            toggle => { root.toggle(); }
            link(u) => { root.link(u); }
        }
        if msg.kind == "tool": ToolFrame {
            tool: msg.tool;
            error: msg.error;
            not-run: msg.not-run;
            expanded: msg.expanded;
            toggle => { root.toggle(); }
            status: true;
            running: msg.running;
            live: msg.live;
            approval: msg.approval;
            copy => { root.copy(msg.text); }
        }
        if msg.kind == "note": Note { msg: msg; }
        if msg.kind == "footer": Text {
            text: msg.text;
            font-size: Theme.font-xs;
            color: Theme.dim;
            overflow: elide;
        }
    }
}

// The transcript list. It follows the bottom while `follow` is true. Any
// user scroll clears it at once: the wheel calls `scrolled` before its
// animation moves `content-y` (so `content-y` cannot tell the direction
// there). The ListView's own bar is off: the themed bar (scrollbar.slint)
// clears `follow` before it moves `content-y`, so a drag, a track click or
// the wheel over it during a ListView re-estimate never snaps back down;
// the `changed content-y` check still catches other moves. Coming back to
// the bottom sets it again; "Jump to latest" does it in one click.
export component TranscriptView {
    in property <[MsgRow]> rows;
    // A session's log is opening on a worker (D60): the list says so in a
    // word, above the rows shown until its result comes.
    in property <bool> loading;
    in-out property <bool> follow: true;
    property <length> bottom: min(0px, list.visible-height - list.content-height);
    // How far the view is above the bottom: exact while the last row is
    // laid out, whatever the ListView's height estimate.
    property <length> gap: list.content-y - root.bottom;
    // `gap` at the last `content-y` change: reaching the bottom follows
    // again. Leaving it is a user action only (`scrolled`, the bar's
    // `scroll-to`): a growing gap is not, since the list moves `content-y`
    // itself while it measures the rows of a session just shown, and that
    // read as a scroll up (2026-11-13: Jump to latest after a switch).
    property <length> last-gap;
    callback toggle(int);
    callback copy(string);
    callback link(string);
    // The themed bar's thumb centre in window coordinates (for the tests).
    out property <length> thumb-x: bar.thumb-x;
    out property <length> thumb-y: bar.thumb-y;
    // The rows' height as the list measured it (for the layout tests).
    out property <length> content-height: list.content-height;

    public function to-bottom() {
        root.follow = true;
        list.content-y = root.bottom;
    }

    list := ListView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        for item[i] in root.rows: MessageView {
            msg: item;
            copy(t) => { root.copy(t); }
            toggle => { root.toggle(i); }
            link(u) => { root.link(u); }
        }
        scrolled => {
            root.follow = false;
        }
        changed content-y => {
            if (root.gap <= 1px && root.last-gap > 1px) {
                root.follow = true;
            }
            root.last-gap = root.gap;
        }
        changed content-height => {
            if (root.follow) {
                self.content-y = root.bottom;
            }
        }
    }

    bar := ScrollBar {
        x: parent.width - self.width;
        height: parent.height;
        content-y: list.content-y;
        content-height: list.content-height;
        visible-height: list.visible-height;
        scroll-to(y) => {
            root.follow = false;
            list.content-y = y;
        }
    }

    // The word shown while a session opens: a word, never colour only. It is
    // a component (blocks.slint), since a plain layout under an `if` measures
    // its wrapped text at its unwrapped width (pitfalls-gui). It comes after
    // the list, on an opaque strip: the rows of the session still shown
    // (scrolled to its end) drew over it and hid it (2026-11-13).
    if root.loading: Rectangle {
        x: 0;
        y: 0;
        width: parent.width;
        height: min(parent.height, loading-line.preferred-height);
        background: Theme.surface;
        loading-line := LoadingLine {}
    }

    // Jump to latest: a round gradient button with a halo on hover.
    if !root.follow: Rectangle {
        x: parent.width - self.width - Theme.space-xl;
        y: parent.height - self.height - Theme.space-m;
        width: Theme.control-height + 4px;
        height: Theme.control-height + 4px;
        Elevation { radius: self.height / 2; level: 1.5; }
        if jump.has-hover: Halo { radius: parent.height / 2; }
        AccentFill { radius: parent.height / 2 - 1px; }
        Mark {
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            text: Icons.arrow-down;
            color: Theme.on-accent;
            font-size: Theme.font-m + 2px;
        }
        jump := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.to-bottom(); }
        }
        Rectangle {
            accessible-role: button;
            accessible-label: "Jump to latest";
            accessible-action-default => { root.to-bottom(); }
        }
    }
}