import { ListView } from "std-widgets.slint";
import { MsgRow } from "types.slint";
import { Theme, LinkText, Columns, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { BusySpinner, IconButton } from "widgets.slint";
import { ScrollBar } from "scrollbar.slint";

// The user's message: a bubble on the right, at most 80% of the column.
component UserBubble {
    in property <MsgRow> msg;
    callback copy(string);
    VerticalLayout {
        spacing: Theme.space-xs;
        HorizontalLayout {
            alignment: end;
            Rectangle {
                max-width: root.width * 0.8;
                border-radius: Theme.radius-l;
                background: Theme.bubble;
                HorizontalLayout {
                    padding-left: Theme.space-l - 2px;
                    padding-right: Theme.space-l - 2px;
                    padding-top: Theme.space-s + 2px;
                    padding-bottom: Theme.space-s + 2px;
                    Text {
                        text: msg.shown;
                        wrap: word-wrap;
                        color: Theme.text;
                        font-size: Theme.font-m;
                    }
                }
            }
        }
        LinkText {
            text: "Copy";
            horizontal-alignment: right;
            clicked => { root.copy(msg.text); }
        }
    }
}

component AssistantBlock {
    in property <MsgRow> msg;
    callback copy(string);
    callback toggle();
    callback link(string);
    VerticalLayout {
        spacing: Theme.space-s;
        if msg.thinking != "": HorizontalLayout {
            spacing: Theme.space-xs;
            alignment: start;
            Mark { text: msg.expanded ? Icons.chevron-down : Icons.chevron-right; color: Theme.dim; font-size: Theme.font-s; }
            LinkText {
                text: msg.expanded ? "Hide thinking" : "Show thinking";
                font-size: Theme.font-s;
                clicked => { root.toggle(); }
            }
        }
        if msg.thinking != "" && msg.expanded: HorizontalLayout {
            spacing: Theme.space-m;
            Rectangle {
                width: 2px;
                border-radius: 1px;
                background: Theme.line;
            }
            Text {
                text: msg.thinking;
                wrap: word-wrap;
                color: Theme.dim;
                font-size: Theme.font-s;
                font-italic: true;
            }
        }
        if msg.text != "": StyledText {
            text: msg.body;
            default-color: Theme.text;
            default-font-size: Theme.font-m;
            link-color: Theme.accent;
            link-clicked(url) => { root.link(url); }
        }
        if msg.text != "": LinkText {
            text: "Copy";
            clicked => { root.copy(msg.text); }
        }
    }
}

// The status of a tool: dots while it runs, then a mark and a word, so the
// state never rests on colour alone.
component ToolStatus {
    in property <MsgRow> msg;
    HorizontalLayout {
        if msg.running: BusySpinner { label: "Running " + msg.title; }
        if !msg.running && !msg.error: Mark {
            text: Icons.check;
            color: Theme.success;
            font-size: Theme.font-m;
            accessible-role: text;
            accessible-label: "done";
        }
        if msg.error: HorizontalLayout {
            spacing: Theme.space-xs;
            Mark { text: Icons.error; color: Theme.error; font-size: Theme.font-s; }
            Text {
                text: "failed";
                color: Theme.error;
                font-size: Theme.font-s;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}

component ToolCard inherits Rectangle {
    in property <MsgRow> msg;
    callback copy(string);
    callback toggle();
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: msg.error ? Theme.error : Theme.line;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-s + 2px;
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-s;
        HorizontalLayout {
            spacing: Theme.space-s;
            ToolStatus { msg: msg; }
            Text {
                text: msg.title;
                font-family: Theme.mono;
                font-size: Theme.font-s;
                font-weight: 700;
                color: Theme.text;
                vertical-alignment: center;
            }
            Text {
                text: msg.summary;
                color: Theme.dim;
                font-size: Theme.font-s;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if !msg.running: LinkText {
                text: msg.expanded ? "Hide output" : "Show output";
                vertical-alignment: center;
                clicked => { root.toggle(); }
            }
            if !msg.running: LinkText {
                text: "Copy";
                vertical-alignment: center;
                clicked => { root.copy(msg.text); }
            }
        }
        if msg.expanded && !msg.running: Rectangle {
            border-radius: Theme.radius-s;
            background: Theme.code;
            HorizontalLayout {
                padding: Theme.space-s + 2px;
                Text {
                    text: msg.output;
                    wrap: word-wrap;
                    font-family: Theme.mono;
                    font-size: Theme.font-s;
                    color: Theme.text;
                }
            }
        }
    }
}

// A note line: a mark per kind (refresh: retry, git-compare: switch, error, info).
component Note {
    in property <MsgRow> msg;
    property <color> tint: msg.tone == "error" ? Theme.error : msg.tone == "retry" ? Theme.warning : msg.tone == "switch" ? Theme.accent : Theme.dim;
    HorizontalLayout {
        spacing: Theme.space-s;
        Mark {
            width: 14px;
            vertical-alignment: top;
            horizontal-alignment: center;
            text: msg.tone == "retry" ? Icons.refresh : msg.tone == "switch" ? Icons.git-compare : msg.tone == "error" ? Icons.error : Icons.info;
            color: root.tint;
            font-size: Theme.font-m;
        }
        Text {
            text: msg.shown;
            wrap: word-wrap;
            font-size: Theme.font-s;
            color: root.tint;
        }
    }
}

component MessageView {
    in property <MsgRow> msg;
    callback copy(string);
    callback toggle();
    callback link(string);
    VerticalLayout {
        padding-left: Columns.side(root.width, Theme.column-width);
        padding-right: Columns.side(root.width, Theme.column-width);
        padding-top: msg.kind == "footer" ? 0px : msg.kind == "user" ? Theme.space-l : Theme.space-s;
        padding-bottom: msg.kind == "footer" ? Theme.space-s : 2px;
        if msg.kind == "user": UserBubble {
            msg: msg;
            copy(t) => { root.copy(t); }
        }
        if msg.kind == "assistant": AssistantBlock {
            msg: msg;
            copy(t) => { root.copy(t); }
            toggle => { root.toggle(); }
            link(u) => { root.link(u); }
        }
        if msg.kind == "tool": ToolCard {
            msg: msg;
            copy(t) => { root.copy(t); }
            toggle => { root.toggle(); }
        }
        if msg.kind == "note": Note { msg: msg; }
        if msg.kind == "footer": Text {
            text: msg.text;
            font-size: Theme.font-xs;
            color: Theme.dim;
            overflow: elide;
        }
    }
}

// The transcript list. It follows the bottom while `follow` is true. Any
// user scroll clears it at once: the wheel calls `scrolled` before its
// animation moves `content-y` (so `content-y` cannot tell the direction
// there). The ListView's own bar is off: the themed bar (scrollbar.slint)
// clears `follow` before it moves `content-y`, so a drag, a track click or
// the wheel over it during a ListView re-estimate never snaps back down;
// the `changed content-y` check still catches other moves. Coming back to
// the bottom sets it again; "Jump to latest" does it in one click.
export component TranscriptView {
    in property <[MsgRow]> rows;
    in-out property <bool> follow: true;
    property <length> bottom: min(0px, list.visible-height - list.content-height);
    // How far the view is above the bottom: exact while the last row is
    // laid out, whatever the ListView's height estimate.
    property <length> gap: list.content-y - root.bottom;
    // `gap` and `content-height` at the last `content-y` change: the gap
    // growing with an unchanged height is the user's scroll.
    property <length> last-gap;
    property <length> last-height;
    callback toggle(int);
    callback copy(string);
    callback link(string);
    // The themed bar's thumb centre in window coordinates (for the tests).
    out property <length> thumb-x: bar.thumb-x;
    out property <length> thumb-y: bar.thumb-y;

    public function to-bottom() {
        root.follow = true;
        list.content-y = root.bottom;
        root.last-height = list.content-height;
    }

    list := ListView {
        width: 100%;
        height: 100%;
        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
        for item[i] in root.rows: MessageView {
            msg: item;
            copy(t) => { root.copy(t); }
            toggle => { root.toggle(i); }
            link(u) => { root.link(u); }
        }
        scrolled => {
            root.follow = false;
        }
        changed content-y => {
            if (root.gap > root.last-gap + 0.5px && self.content-height == root.last-height) {
                root.follow = false;
            } else if (root.gap <= 1px && root.last-gap > 1px) {
                root.follow = true;
            }
            root.last-gap = root.gap;
            root.last-height = self.content-height;
        }
        changed content-height => {
            if (root.follow) {
                self.content-y = root.bottom;
                // A snap to the same `content-y` fires no `changed content-y`.
                root.last-height = self.content-height;
            }
        }
    }

    bar := ScrollBar {
        x: parent.width - self.width;
        height: parent.height;
        content-y: list.content-y;
        content-height: list.content-height;
        visible-height: list.visible-height;
        scroll-to(y) => {
            root.follow = false;
            list.content-y = y;
        }
    }

    if !root.follow: Rectangle {
        x: parent.width - self.width - Theme.space-xl;
        y: parent.height - self.height - Theme.space-m;
        width: Theme.control-height;
        height: Theme.control-height;
        border-radius: Theme.radius-s;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.raised;
        IconButton {
            icon: Icons.arrow-down;
            label: "Jump to latest";
            clicked => { root.to-bottom(); }
        }
    }
}