// One step's line inside an open run (the owner, 2026-11-15): a tool call
// or a thinking block is one line (icon, name, what it did in dim words,
// its status and duration); a click opens its detail one level in, with
// its own rail in the gutter that folds it again.
import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { BusySpinner, FocusRing } from "widgets.slint";
import { GhostText, CrossSelect } from "selectable.slint";
import { ThinkingQuote } from "blocks.slint";
import { StepRail } from "stepline.slint";

// The icon of a tool card kind (ToolView.kind).
export global DetailIcons {
    pure public function of(kind: string) -> string {
        return kind == "read" ? Icons.eye
            : kind == "write" ? Icons.new-file
            : kind == "edit" ? Icons.edit
            : kind == "grep" || kind == "find" ? Icons.search
            : kind == "glob" ? Icons.files
            : kind == "shell" ? Icons.terminal
            : kind == "subagent" ? Icons.robot
            : kind == "thought" ? Icons.comment-discussion
            : Icons.tools;
    }
}

// The detail's indent right of the line's icon, and the rail under it.
export global DetailLook {
    out property <length> indent: 22px;
    out property <length> rail-x: 2px;
    out property <length> height: 26px;
}

export component DetailLine inherits Rectangle {
    in property <string> icon;
    in property <string> name;
    in property <string> text;
    in property <string> took;
    in property <bool> open;
    in property <bool> running;
    in property <bool> failed;
    // A call the approval gate ended before it ran ("declined").
    in property <string> not-run;
    // The transcript item and place in its row, for the chat's selection.
    in property <int> sel-row: -1;
    in property <int> idx;
    property <bool> lifted;
    callback toggled();
    height: DetailLook.height;
    border-radius: Theme.radius-s;
    background: ta.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.name + " " + root.text + (root.failed ? ", failed" : "");
    accessible-description: root.open ? "Detail open: activate to fold it" : "Detail folded: activate to open it";
    accessible-action-default => { root.toggled(); }
    forward-focus: fs;
    HorizontalLayout {
        padding-right: Theme.space-xs;
        spacing: 8px;
        Mark {
            width: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: root.icon;
            color: root.failed ? Theme.error : Theme.dim;
            font-size: Theme.font-m;
        }
        Text {
            text: root.name;
            color: Theme.text;
            font-size: Theme.font-s;
            font-family: Theme.mono;
            vertical-alignment: center;
        }
        line := GhostText {
            text: root.text;
            color: ta.has-hover || fs.has-focus || root.lifted ? Theme.text : Theme.dim;
            font-size: Theme.font-s;
            valign: center;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 1;
            sel-row: root.sel-row;
            idx: root.idx;
            changed selecting => { if !self.selecting { root.lifted = false; } }
            changed has-hover => { if !self.has-hover && !self.selecting { root.lifted = false; } }
        }
        if root.running: VerticalLayout {
            alignment: center;
            BusySpinner { label: "Running"; }
        }
        if root.failed: Mark {
            vertical-alignment: center;
            text: Icons.error + " failed";
            color: Theme.error;
            font-size: Theme.font-s;
        }
        if root.not-run != "": Text {
            vertical-alignment: center;
            text: root.not-run;
            color: Theme.dim;
            font-size: Theme.font-s;
        }
        if root.took != "": Text {
            vertical-alignment: center;
            text: root.took;
            color: Theme.dim;
            font-size: Theme.font-xs;
        }
        Mark {
            vertical-alignment: center;
            text: root.open ? Icons.chevron-up : Icons.chevron-down;
            color: ta.has-hover || fs.has-focus || root.open ? Theme.dim : transparent;
            font-size: Theme.font-s;
        }
    }
    // A click toggles; a drag (rows in the chat only) hands the press to
    // the text's ghost (ui/cross_select.slint `lift`) and this area steps
    // aside until the selection is gone.
    ta := TouchArea {
        enabled: !root.lifted;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
        moved => {
            if self.pressed && root.sel-row >= 0 && !root.lifted && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 4px {
                root.lifted = true;
                CrossSelect.lift(root.sel-row, root.idx, clamp(self.absolute-position.x + self.pressed-x, line.absolute-position.x + 1px, line.absolute-position.x + max(1px, line.width - 2px)), line.absolute-position.y + line.height / 2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { radius: Theme.radius-s; x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; }
}

// Thinking as a line ("Thought" and its first words); open, the text one
// level in with its rail.
export component ThinkingPart inherits Rectangle {
    in property <string> text;
    in property <string> first;
    in property <bool> open;
    callback toggled();
    min-height: lay.min-height;
    preferred-height: lay.preferred-height;
    lay := VerticalLayout {
        spacing: Theme.space-xs;
        DetailLine {
            icon: DetailIcons.of("thought");
            name: "Thought";
            text: root.first;
            open: root.open;
            toggled => { root.toggled(); }
        }
        if root.open: ThinkingQuote {
            inset: DetailLook.indent;
            text: root.text;
        }
    }
    if root.open: StepRail {
        label: "Collapse thinking";
        x: DetailLook.rail-x;
        y: DetailLook.height + Theme.space-xs;
        height: root.height - self.y;
        clicked => { root.toggled(); }
    }
}
