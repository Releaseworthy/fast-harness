import { AboutSlint } from "std-widgets.slint";
import { Theme, Columns, Card, PageTitle, Eyebrow, Badge } from "parts.slint";
import { ActionButton, Dropdown } from "widgets.slint";
import { PromptSettings } from "prompt_settings.slint";
import { Appearance } from "appearance.slint";
import { ConfigSettings } from "config_settings.slint";

// A labelled settings row: the name, a dropdown and a caption under it.
component SettingRow {
    in property <string> label;
    in property <string> caption;
    in property <string> placeholder;
    in property <[string]> model;
    in property <[bool]> headers;
    in-out property <int> current-index;
    in property <bool> refreshing;
    callback selected(int);
    callback opened();
    VerticalLayout {
        spacing: Theme.space-xs + 2px;
        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-m;
            font-weight: 600;
        }
        Dropdown {
            label: root.label;
            placeholder: root.placeholder;
            model: root.model;
            headers: root.headers;
            current-index <=> root.current-index;
            refreshing: root.refreshing;
            selected(i) => { root.selected(i); }
            opened => { root.opened(); }
        }
        if root.caption != "": Text {
            text: root.caption;
            color: Theme.dim;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
    }
}

// A settings section: a raised card with padding around its content.
component Section inherits Card {
    radius: Theme.radius-xl;
    VerticalLayout {
        padding: Theme.space-xl;
        @children
    }
}

export component SettingsPage inherits Rectangle {
    in property <[string]> models;
    // True for the provider title rows of `models`.
    in property <[bool]> model-headers;
    in property <[string]> efforts;
    in-out property <int> model-index;
    in-out property <int> effort-index;
    // A note after a pick (the effort changed with the model).
    in property <string> note;
    callback model-picked(int);
    callback effort-picked(int);
    // The model or effort list opened (the app refetches the models).
    callback pickers-opened();
    in property <bool> refreshing;
    background: transparent;
    // Scrolls: the System prompt section is taller than the window.
    page-flick := Flickable { content-height: max(self.height, page-column.preferred-height);
    page-column := VerticalLayout {
        width: page-flick.width;
        padding-top: Theme.space-xl;
        padding-bottom: Theme.space-xl;
        padding-left: Columns.side(root.width, 640px);
        padding-right: Columns.side(root.width, 640px);
        spacing: Theme.space-l + 4px;
        alignment: start;
        PageTitle { text: "Settings"; }
        Section { Appearance { } }
        Section { VerticalLayout {
        spacing: Theme.space-l;
        Eyebrow { text: "MODEL"; }
        SettingRow {
            label: "Model";
            model: root.models;
            headers: root.model-headers;
            current-index <=> root.model-index;
            refreshing: root.refreshing;
            selected(i) => { root.model-picked(i); }
            opened => { root.pickers-opened(); }
        }
        SettingRow {
            label: "Thinking effort";
            caption: "Model and effort apply to the next turn of this window (also while a turn runs) and are not saved. The composer has the same pickers.";
            placeholder: "default";
            model: root.efforts;
            current-index <=> root.effort-index;
            refreshing: root.refreshing;
            selected(i) => { root.effort-picked(i); }
            opened => { root.pickers-opened(); }
        }
        if root.note != "": Text { text: root.note; color: Theme.text; font-size: Theme.font-s; wrap: word-wrap; }
        } }
        Section { PromptSettings { } }
        Section { ConfigSettings { } }
    }
    }
}

export component AboutPage inherits Rectangle {
    in property <string> version;
    background: transparent;
    VerticalLayout {
        padding: Theme.space-xl;
        padding-left: Columns.side(root.width, 640px);
        padding-right: Columns.side(root.width, 640px);
        spacing: Theme.space-l;
        alignment: start;
        PageTitle { text: "About"; }
        Section {
            HorizontalLayout {
                spacing: Theme.space-l;
                VerticalLayout {
                    alignment: center;
                    Image {
                        width: 64px;
                        height: 64px;
                        source: Theme.greyscale ? @image-url("../assets/fast-harness-grey-64.png") : @image-url("../assets/fast-harness-64.png");
                        accessible-role: none;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: Theme.space-s;
                    HorizontalLayout {
                        spacing: Theme.space-s;
                        alignment: start;
                        Text { text: "Fast Harness"; color: Theme.text; font-size: Theme.font-xl; font-weight: 700; vertical-alignment: center; }
                        VerticalLayout { alignment: center; Badge { text: root.version; strong: true; } }
                    }
                    Text { text: "A fast native coding agent harness (fast-harness). The interface is made with Slint."; color: Theme.dim; wrap: word-wrap; }
                }
            }
        }
        AboutSlint { }
    }
}
