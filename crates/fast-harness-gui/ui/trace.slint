// The Trace page: the timeline of the session log (what the user sent, each
// request, the thinking, the response, tool calls and results) and the
// step table. Marks and words carry every state next to the colour.
import { ScrollView } from "std-widgets.slint";
import { ScrollBar } from "scrollbar.slint";
import { TraceRow } from "types.slint";
import { Theme, Columns, LinkText, Mark, AccentFill, PageTitle } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, FocusRing } from "widgets.slint";
import { ThinkingQuote, CodeBox } from "blocks.slint";
import { StepsTable } from "steps.slint";
import { ToolFrame } from "toolcard.slint";
import { SelectableText } from "selectable.slint";

// The timeline rows' height as the list measured it (read by the layout
// tests: the page sits under an `if`, so a global carries it out).
export global TraceProbe {
    in-out property <length> content-height;
    // The scroll position, the view's height and top, and the themed bar's
    // thumb centre in window coordinates (for the scroll tests).
    in-out property <length> view-y;
    in-out property <length> visible-height;
    in-out property <length> list-top;
    in-out property <length> thumb-x;
    in-out property <length> thumb-y;
}

// The mark and its colour for each entry kind.
global TraceStyle {
    pure public function mark(entry: TraceRow) -> string {
        if entry.kind == "request" { return Icons.arrow-up; }
        if entry.kind == "answer" { return Icons.arrow-down; }
        if entry.kind == "call" { return Icons.tools; }
        if entry.kind == "result" { return entry.error ? Icons.error : Icons.check; }
        if entry.kind == "failure" { return Icons.error; }
        if entry.kind == "retry" { return Icons.refresh; }
        if entry.kind == "switch" { return Icons.git-compare; }
        if entry.kind == "header" { return Icons.list-flat; }
        return "";
    }
    pure public function tone(entry: TraceRow) -> color {
        if entry.error || entry.kind == "failure" { return Theme.error; }
        if entry.kind == "retry" || entry.kind == "switch" { return Theme.warning; }
        if entry.kind == "result" { return Theme.success; }
        if entry.kind == "call" { return Theme.accent; }
        return Theme.dim;
    }
    // Captions are dim and small; the others read as headings.
    pure public function caption(entry: TraceRow) -> bool {
        return entry.kind == "request" || entry.kind == "answer" || entry.kind == "end" || entry.kind == "header";
    }
}

// The title line: mark, title, then Show all / Show less and Copy.
component EntryHead {
    in property <TraceRow> entry;
    callback toggle();
    callback copy(string);
    HorizontalLayout {
        spacing: Theme.space-s;
        if TraceStyle.mark(entry) != "": Mark {
            text: TraceStyle.mark(entry);
            color: TraceStyle.tone(entry);
            font-size: Theme.font-s;
        }
        SelectableText {
            text: entry.title;
            color: entry.error ? Theme.error : TraceStyle.caption(entry) ? Theme.dim : Theme.text;
            font-size: TraceStyle.caption(entry) ? Theme.font-xs : Theme.font-s;
            font-weight: TraceStyle.caption(entry) ? 400 : 600;
            font-italic: entry.kind == "thinking";
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if entry.long: LinkText {
            text: entry.expanded ? "Show less" : "Show all";
            vertical-alignment: center;
            clicked => { root.toggle(); }
        }
        LinkText {
            text: "Copy";
            vertical-alignment: center;
            clicked => { root.copy(entry.copy); }
        }
    }
}

// The user's message on the bubble colour. Every `if` below that holds
// wrapped text has a component as its root (ui/blocks.slint says why).
component UserBody inherits Rectangle {
    in property <string> text;
    border-radius: Theme.radius-xl;
    background: Theme.bubble;
    border-width: 1px;
    border-color: Theme.accent.with-alpha(0.3);
    HorizontalLayout {
        padding: Theme.space-s + 2px;
        padding-left: Theme.space-l - 2px;
        padding-right: Theme.space-l - 2px;
        SelectableText { text: root.text; font-size: Theme.font-m; }
    }
}

component EntryBody {
    in property <TraceRow> entry;
    in property <string> shown;
    VerticalLayout {
        if entry.kind == "user": UserBody { text: root.shown; }
        if entry.kind == "thinking": ThinkingQuote { text: root.shown; }
        if entry.kind == "response": SelectableText {
            text: root.shown;
            color: Theme.text;
            font-size: Theme.font-m;
            wrap: word-wrap;
        }
        // Tool arguments, tool output and the system prompt.
        if entry.kind == "call" || entry.kind == "result" || entry.kind == "header": CodeBox {
            text: root.shown;
            error: entry.error;
        }
        if entry.kind == "failure" || entry.kind == "retry" || entry.kind == "switch": SelectableText {
            text: root.shown;
            color: Theme.dim;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
    }
}

// One timeline entry in the centred column; a turn is a section header.
component TraceEntryView {
    in property <TraceRow> entry;
    callback toggle();
    callback copy(string);
    property <string> shown: entry.long && !entry.expanded ? entry.preview : entry.body;
    VerticalLayout {
        padding-left: Columns.side(root.width, Theme.column-width);
        padding-right: Columns.side(root.width, Theme.column-width);
        padding-top: entry.kind == "turn" ? Theme.space-xl : entry.kind == "user" || entry.kind == "request" ? Theme.space-m : Theme.space-s;
        padding-bottom: entry.kind == "turn" ? Theme.space-xs : 2px;
        spacing: Theme.space-xs + 2px;
        if entry.kind == "turn": HorizontalLayout {
            spacing: Theme.space-m;
            Rectangle {
                width: turn-label.preferred-width + 2 * Theme.space-m;
                height: 24px;
                AccentFill { radius: 12px; }
                turn-label := Text {
                    text: entry.title;
                    color: Theme.on-accent;
                    font-size: Theme.font-s;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Rectangle { height: 2px; background: @linear-gradient(90deg, Theme.accent2 0%, Theme.line 100%); }
            }
        }
        // A tool entry's card names the tool and holds Show all and Copy.
        if entry.kind != "turn" && entry.tool.kind == "": EntryHead {
            entry: entry;
            toggle => { root.toggle(); }
            copy(t) => { root.copy(t); }
        }
        if entry.kind != "turn" && entry.tool.kind == "" && root.shown != "": EntryBody { entry: entry; shown: root.shown; }
        // Tool calls and results with tool information: the same tool card,
        // a result with its status.
        if entry.tool.kind != "": ToolFrame {
            tool: entry.tool;
            error: entry.error;
            expanded: entry.expanded;
            elevation: 0;
            caption: entry.kind == "result" ? "result" : "call";
            status: entry.kind == "result";
            copy-link: true;
            toggle => { root.toggle(); }
            copy => { root.copy(entry.copy); }
        }
    }
}

// Timeline | Steps: a two-way switch; the picked side is filled and bold.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    min-width: 84px;
    border-radius: Theme.radius-s;
    background: !root.checked && ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.checked;
    accessible-action-default => { root.clicked(); }
    forward-focus: fs;
    if root.checked: AccentFill { radius: Theme.radius-s; }
    HorizontalLayout {
        alignment: center;
        spacing: Theme.space-xs + 2px;
        if root.checked: Mark { text: Icons.circle-filled; font-size: Theme.font-xs; color: Theme.on-accent; }
        Text {
            text: root.text;
            color: root.checked ? Theme.on-accent : Theme.text;
            font-size: Theme.font-s;
            font-weight: root.checked ? 700 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.clicked(); return accept; }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { radius: Theme.radius-s - 2px; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

component ModeSwitch inherits Rectangle {
    in-out property <string> mode;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.raised;
    accessible-role: tab-list;
    accessible-label: "Trace view";
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        Segment { text: "Timeline"; checked: root.mode == "timeline"; clicked => { root.mode = "timeline"; } }
        Segment { text: "Steps"; checked: root.mode == "steps"; clicked => { root.mode = "steps"; } }
    }
}

// The timeline's list (src/trace_list.rs): the entries to draw, every
// entry's top and the end, the scroll position, the entries to measure off
// screen, and the view's size; Rust places them on `sync`.
export global TraceList {
    in property <[int]> slots;
    in property <[length]> tops;
    in-out property <length> offset;
    in property <[int]> probes;
    in-out property <length> list-height;
    in-out property <length> width;
    callback sync();
    // A laid out entry's height: list row, its index, its height.
    callback measured(int, int, length);
    // An entry's Show all / Show less is about to run: Rust keeps it in place.
    callback anchor(int, int, bool);
}

// The timeline (2026-11-14): its own virtual list with measured entry
// heights, as the chat's (src/virtual_list.rs), not Slint's ListView, whose
// content height came from the rows it had laid out, so the thumb changed
// size while dragging.
component TraceTimeline inherits Rectangle {
    in property <[TraceRow]> entries;
    callback toggle(int);
    callback copy(string);
    property <length> total: TraceList.tops.length > 0 ? TraceList.tops[TraceList.tops.length - 1] : 0px;
    property <length> max-offset: max(0px, root.total - root.height);
    property <length> offset: TraceList.offset;
    property <int> count: root.entries.length;
    property <length> font: Theme.font-m;
    // A drawn entry changed: one sync for all of them.
    property <bool> stale;
    function sync() {
        TraceList.width = root.width;
        TraceList.list-height = root.height;
        TraceProbe.visible-height = root.height;
        TraceProbe.list-top = root.absolute-position.y;
        TraceList.sync();
    }
    init => { root.sync(); }
    changed entries => { root.sync(); }
    changed count => { root.sync(); }
    changed width => { root.sync(); }
    changed height => { root.sync(); }
    changed font => { root.sync(); }
    changed stale => {
        if root.stale {
            root.stale = false;
            root.sync();
        }
    }
    changed total => { TraceProbe.content-height = root.total; }
    changed offset => { TraceProbe.view-y = -root.offset; }
    function scroll(y: length) {
        TraceList.offset = max(0px, min(root.max-offset, y));
        root.sync();
    }
    TouchArea {
        scroll-event(e) => {
            root.scroll(TraceList.offset - e.delta-y);
            return accept;
        }
    }
    Rectangle {
        clip: true;
        for slot in TraceList.slots: TraceEntryView {
            property <length> natural: self.preferred-height;
            property <bool> born;
            x: 0;
            y: TraceList.tops[slot] - TraceList.offset;
            width: parent.width;
            height: self.natural;
            entry: root.entries[slot];
            init => { self.born = true; }
            changed born => { TraceList.measured(slot, slot, self.natural); }
            changed natural => { TraceList.measured(slot, slot, self.natural); }
            changed entry => { root.stale = true; }
            toggle => {
                TraceList.anchor(slot, -1, false);
                root.toggle(slot);
                root.sync();
            }
            copy(t) => { root.copy(t); }
        }
    }
    // The lane: entries laid out off screen, a batch at a time (visible and
    // unclipped: Slint builds `if` parts only when its renderer visits them).
    for slot in TraceList.probes: TraceEntryView {
        property <length> natural: self.preferred-height;
        property <bool> born;
        x: -100000px;
        y: 0;
        width: root.width;
        height: self.natural;
        entry: root.entries[slot];
        init => { self.born = true; }
        changed born => { TraceList.measured(slot, slot, self.natural); }
        changed natural => { TraceList.measured(slot, slot, self.natural); }
    }
    ScrollBar {
        x: parent.width - self.width;
        height: parent.height;
        content-y: -TraceList.offset;
        content-height: root.total;
        visible-height: root.height;
        scroll-to(y) => { root.scroll(-y); }
        init => { TraceProbe.thumb-x = self.thumb-x; TraceProbe.thumb-y = self.thumb-y; }
        changed thumb-x => { TraceProbe.thumb-x = self.thumb-x; }
        changed thumb-y => { TraceProbe.thumb-y = self.thumb-y; }
    }
}

export component TracePage inherits Rectangle {
    in property <[TraceRow]> entries;
    in property <[[string]]> steps;
    in property <string> session;
    in property <string> message;
    in-out property <string> mode: "timeline";
    callback refresh();
    callback toggle(int);
    callback copy(string);
    background: transparent;
    VerticalLayout {
        Rectangle {
            HorizontalLayout {
                padding: Theme.space-l;
                padding-left: Theme.space-xl;
                padding-right: Theme.space-xl;
                spacing: Theme.space-m;
                PageTitle { text: "Trace"; horizontal-stretch: 0; }
                Text {
                    text: root.session;
                    color: Theme.dim;
                    font-size: Theme.font-xs;
                    font-family: Theme.mono;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                ModeSwitch { mode <=> root.mode; }
                ActionButton { icon: Icons.refresh; text: "Refresh"; clicked => { root.refresh(); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
        }
        if root.message != "": Text {
            text: root.message;
            color: Theme.dim;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
            height: 80px;
        }
        if root.mode == "timeline": TraceTimeline {
            vertical-stretch: 1;
            entries: root.entries;
            toggle(i) => { root.toggle(i); }
            copy(t) => { root.copy(t); }
        }
        if root.mode == "steps": StepsTable {
            vertical-stretch: 1;
            rows: root.steps;
        }
    }
}
