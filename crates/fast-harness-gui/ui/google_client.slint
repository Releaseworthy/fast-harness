// The Google OAuth client form of the Google provider page (PLAN.md D25,
// D32): Save writes google-client.json with the secret encrypted; the
// secret field clears and the secret is never shown again.
import { Theme, Badge, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, KeyInput } from "widgets.slint";

export component ClientForm inherits Rectangle {
    in property <bool> ready;
    // The saved client id (not a secret), shown to edit.
    in property <string> saved-id;
    // The result of the last Save, in words; `error` marks a failure.
    in property <string> note;
    in property <bool> error;
    callback save(string, string);
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: root.ready ? Theme.line : Theme.warning;
    background: Theme.surface;
    VerticalLayout {
        padding: Theme.space-l - 2px;
        spacing: Theme.space-s + 2px;
        HorizontalLayout {
            spacing: Theme.space-s;
            Mark { text: Icons.key; color: Theme.text; font-size: Theme.font-m; }
            Text { text: "OAuth client"; color: Theme.text; font-size: Theme.font-m; font-weight: 600; vertical-alignment: center; }
            VerticalLayout { alignment: center; Badge { text: root.ready ? "Set" : "Needs setup"; strong: root.ready; height: 20px; } }
            Rectangle { horizontal-stretch: 1; }
        }
        Text {
            text: root.ready
                ? "Google sign-in uses this client. Save another one to replace it."
                : "Google sign-in needs your own OAuth client (a Desktop app client from the Google Cloud console). Enter its ID and secret, then Add Google account.";
            color: Theme.dim;
            font-size: Theme.font-s;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: Theme.space-s;
            id-edit := KeyInput { placeholder: "Client ID"; text: root.saved-id; horizontal-stretch: 3; }
            secret-edit := KeyInput {
                placeholder: "Client secret";
                password: true;
                horizontal-stretch: 2;
                accepted => { save.clicked(); }
            }
            save := ActionButton {
                icon: Icons.check;
                text: "Save";
                variant: "primary";
                clicked => {
                    root.save(id-edit.text, secret-edit.text);
                    secret-edit.text = "";
                }
            }
        }
        Text {
            text: "The secret is encrypted on this computer and never shown again.";
            color: Theme.dim;
            font-size: Theme.font-xs;
        }
        if root.note != "": HorizontalLayout {
            spacing: Theme.space-s;
            Mark {
                text: root.error ? Icons.error : Icons.check;
                color: root.error ? Theme.error : Theme.success;
                font-size: Theme.font-s;
            }
            Text {
                text: root.note;
                color: root.error ? Theme.error : Theme.text;
                font-size: Theme.font-s;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
}
