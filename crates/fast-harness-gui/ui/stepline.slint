// The step line and rail of the chat (PLAN.md D73).
import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { BusySpinner, FocusRing } from "widgets.slint";
import { GhostText, CrossSelect } from "selectable.slint";

// One step folded into a line: a chevron on the left (up when the step is
// open) and what the step did in dim words, a running spinner and an error
// mark next to the words that say so. A click, Enter or Space opens or
// folds the step.
export component StepLine inherits Rectangle {
    in property <string> text;
    // The words with counts: the accessible label.
    in property <string> label;
    in property <bool> open;
    in property <bool> running;
    in property <bool> failed;
    // The transcript item and place in its row, for the chat's selection.
    in property <int> sel-row: -1;
    in property <int> idx;
    property <bool> lifted;
    callback toggled();
    height: 26px;
    border-radius: Theme.radius-s;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.open ? "Step open: activate to fold it" : "Step folded: activate to show every call";
    accessible-action-default => { root.toggled(); }
    forward-focus: fs;
    // The first verb of the run (core `StepSummary::kind`) picks the icon;
    // empty on a folded turn's line, which keeps the chevron.
    in property <string> kind;
    HorizontalLayout {
        padding-left: 0px;
        padding-right: Theme.space-xs;
        spacing: 8px;
        // The icon sits at the text column's left edge, as the owner's
        // compact turn (DSH web chat) does.
        Mark {
            width: 16px;
            horizontal-alignment: center;
            vertical-alignment: center;
            text: StepIcons.of(root.kind, root.open);
            color: Theme.dim;
            font-size: Theme.font-m;
        }
        if root.running: VerticalLayout {
            alignment: center;
            BusySpinner { label: "Step running"; }
        }
        if root.failed: Mark {
            vertical-alignment: center;
            text: Icons.error;
            color: Theme.error;
            font-size: Theme.font-s;
        }
        line := GhostText {
            text: root.text;
            color: ta.has-hover || fs.has-focus || root.lifted ? Theme.text : Theme.dim;
            font-size: Theme.font-m;
            valign: center;
            overflow: elide;
            wrap: no-wrap;
            horizontal-stretch: 0;
            sel-row: root.sel-row;
            idx: root.idx;
            changed selecting => { if !self.selecting { root.lifted = false; } }
            changed has-hover => { if !self.has-hover && !self.selecting { root.lifted = false; } }
        }
        // Up while open; down on hover or focus says the line opens.
        if root.kind != "" && (root.open || ta.has-hover || fs.has-focus): Mark {
            vertical-alignment: center;
            text: root.open ? Icons.chevron-up : Icons.chevron-down;
            color: Theme.dim;
            font-size: Theme.font-s;
        }
        Rectangle { horizontal-stretch: 1; }
    }
    // A click toggles; a drag (rows in the chat only) hands the press to
    // the text's ghost (ui/cross_select.slint `lift`) and this area steps
    // aside until the selection is gone.
    ta := TouchArea {
        enabled: !root.lifted;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
        moved => {
            if self.pressed && root.sel-row >= 0 && !root.lifted && abs(self.mouse-x - self.pressed-x) + abs(self.mouse-y - self.pressed-y) > 4px {
                root.lifted = true;
                CrossSelect.lift(root.sel-row, root.idx, clamp(self.absolute-position.x + self.pressed-x, line.absolute-position.x + 1px, line.absolute-position.x + max(1px, line.width - 2px)), line.absolute-position.y + line.height / 2, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    fs := FocusScope {
        focus-on-click: false;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " {
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { radius: Theme.radius-s; x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px; }
}

// The icon of a run's line by its first verb; a turn's line (no kind)
// draws the chevron.
export global StepIcons {
    pure public function of(kind: string, open: bool) -> string {
        return kind == "" ? (open ? Icons.chevron-up : Icons.chevron-down)
            : kind == "ran" ? Icons.terminal
            : kind == "read" ? Icons.eye
            : kind == "edited" ? Icons.edit
            : kind == "searched" ? Icons.search
            : kind == "web" || kind == "fetched" ? Icons.link-external
            : kind == "created" ? Icons.robot
            : kind == "checked" ? Icons.watch
            : kind == "thought" ? Icons.comment-discussion
            : Icons.tools;
    }
}

// The hovered rails (D80): every row draws its own segment of a turn's or
// a step's rail, so the hover is shared by the group's first row number.
// The rail's resting alpha over the dim text colour: decoration only (the
// hover and the focus ring carry the 3:1 contrast).
export global RailLook {
    out property <float> alpha: 0.18;
}

export global Rails {
    in-out property <int> turn: -1;
    in-out property <int> step: -1;
}

// The faint line on the left of an open step's rows: a 12 px hit area
// whose click folds the step; the whole rail widens and darkens while the
// pointer is on any of its segments (`lit`). Square ends: the segments of
// consecutive rows join into one line (rounded ends left 2 px dim notches).
export component StepRail inherits Rectangle {
    in property <string> label: "Collapse step";
    in property <bool> lit: rail.has-hover;
    out property <bool> hovered: rail.has-hover;
    callback clicked();
    width: 12px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Rectangle {
        x: root.lit ? 4px : 5px;
        width: root.lit ? 3px : 2px;
        // Theme.line vanished on light themes: the dim text colour, faint
        // (0.32 before the owner asked for a more transparent bar,
        // 2026-11-14); the hover still draws it in full.
        background: root.lit ? Theme.dim : Theme.dim.with-alpha(RailLook.alpha);
    }
    rail := TouchArea {
        mouse-cursor: pointer;
        // The rail may fold away under the pointer (no hover-off then).
        clicked => { Rails.turn = -1; Rails.step = -1; root.clicked(); }
    }
}
