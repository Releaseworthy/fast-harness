// The main panel's frame: the tab strip at the top, the error banner and
// the status bar at the bottom.
import { Theme, Mark, Card } from "parts.slint";
import { Icons } from "icons.slint";
import { ActionButton, IconButton } from "widgets.slint";
import { PanelUi } from "panel_view.slint";
import { SubagentsTab, JobsTab, SubagentsUi, JobsUi } from "subagents.slint";

// One tab: an icon and a word. The selected tab reads in the text colour,
// bold, with a 2px accent underline (never colour alone).
component Tab inherits Rectangle {
    in property <string> icon;
    in property <string> text;
    in property <bool> selected;
    in property <bool> closable;
    callback clicked();
    callback close();
    width: row.preferred-width;
    border-radius: Theme.radius-m;
    background: root.selected ? Theme.accent-surface : ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: tab;
    accessible-label: root.text;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: root.closable ? Theme.space-xs : Theme.space-m;
        spacing: Theme.space-s;
        Mark {
            text: root.icon;
            font-size: Theme.font-m;
            color: root.selected ? Theme.accent : Theme.dim;
        }
        Text {
            text: root.text;
            font-size: Theme.font-s;
            font-weight: root.selected ? 700 : 500;
            color: root.selected ? Theme.text : Theme.dim;
            vertical-alignment: center;
            accessible-role: none;
        }
        if root.closable: VerticalLayout {
            alignment: center;
            IconButton {
                width: 24px;
                height: 24px;
                icon: Icons.close;
                icon-size: Theme.font-s;
                label: "Close " + root.text;
                clicked => { root.close(); }
            }
        }
    }
    if root.selected: Rectangle {
        x: Theme.space-s;
        y: parent.height - 2px;
        width: parent.width - 2 * Theme.space-s;
        height: 2px;
        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
    }
}

// Chat and Trace, then Subagents and Jobs while the shown session has any
// (D76: each opens its popover under it); while Accounts or a panel is
// open, one more tab shows it, and its close button returns to Chat.
// Settings and About are dialogs (dialog.slint), not tabs.
export component TabStrip inherits Rectangle {
    in property <string> page;
    // The height a Subagents or Jobs popover may take.
    in property <length> room: 480px;
    callback open-page(string);
    property <bool> extra: root.page == "accounts" || root.page == "panel";
    height: 44px;
    accessible-role: tab-list;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-top: Theme.space-s - 2px;
        padding-bottom: Theme.space-s - 2px;
        spacing: Theme.space-xs;
        alignment: start;
        Tab {
            icon: Icons.comment-discussion;
            text: "Chat";
            selected: root.page == "chat";
            clicked => { root.open-page("chat"); }
        }
        Tab {
            icon: Icons.pulse;
            text: "Trace";
            selected: root.page == "trace";
            clicked => { root.open-page("trace"); }
        }
        if SubagentsUi.count > 0: SubagentsTab { room: root.room; span: root.width - self.x - Theme.space-m; }
        if JobsUi.count > 0: JobsTab { room: root.room; span: root.width - self.x - Theme.space-m; }
        if root.extra: Tab {
            icon: root.page == "panel" ? PanelUi.icon : Icons.account;
            text: root.page == "panel" ? PanelUi.title : "Accounts";
            selected: true;
            closable: true;
            close => { root.open-page("chat"); }
        }
    }
}

export component StatusBar inherits Rectangle {
    in property <string> state;
    in property <string> model;
    in property <string> account;
    in property <string> tokens;
    in property <string> timing;
    height: 28px;
    background: Theme.surface;
    Rectangle { y: 0; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m;
        spacing: Theme.space-l;
        // The state: a dot and the word (the dot's colour is never the only cue).
        HorizontalLayout {
            spacing: Theme.space-xs + 2px;
            Mark {
                text: Icons.circle-filled;
                font-size: 8px;
                color: root.state == "Ready" ? Theme.success : root.state == "Error" ? Theme.error : Theme.accent;
            }
            Text { text: root.state; font-size: Theme.font-xs; font-weight: 600; color: Theme.text; vertical-alignment: center; }
        }
        Text { text: root.model; font-size: Theme.font-xs; color: Theme.dim; vertical-alignment: center; }
        Text { text: root.account; font-size: Theme.font-xs; color: Theme.dim; vertical-alignment: center; overflow: elide; }
        Rectangle { horizontal-stretch: 1; }
        Text { text: root.tokens; font-size: Theme.font-xs; color: Theme.dim; vertical-alignment: center; }
        Text { text: root.timing; font-size: Theme.font-xs; color: Theme.dim; vertical-alignment: center; }
    }
}

// An error: a mark and a word next to the colour (WCAG 1.4.1).
export component ErrorBanner inherits Rectangle {
    in property <string> text;
    callback dismiss();
    accessible-role: AccessibleRole.text;
    accessible-label: "Error: " + root.text;
    // The size comes from the content row, not from the card layers.
    preferred-height: row.preferred-height;
    min-height: row.min-height;
    Card { radius: Theme.radius-l; edge: Theme.error; }
    // The error stripe on the left edge, inside the rounded corners.
    Rectangle {
        x: 5px;
        y: Theme.space-s;
        width: 3px;
        height: parent.height - 2 * Theme.space-s;
        border-radius: 1.5px;
        background: Theme.error;
    }
    row := HorizontalLayout {
        padding: Theme.space-s;
        padding-left: Theme.space-l;
        spacing: Theme.space-m;
        Mark { text: Icons.error; color: Theme.error; font-size: Theme.font-l - 2px; }
        Text {
            text: "Error";
            color: Theme.error;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: Theme.text;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        ActionButton { text: "Dismiss"; variant: "ghost"; clicked => { root.dismiss(); } }
    }
}
