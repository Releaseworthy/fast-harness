// Themed controls that replace the std-widgets ones, so every colour comes
// from the `Theme` global (the Fluent widgets take the OS accent colour).
import { Theme, Mark, AccentFill, Halo } from "parts.slint";
import { Icons } from "icons.slint";

// The 2px focus ring with a glow halo outside it; users place it 1px
// outside the control (WCAG 2.4.7 and 2.4.13).
export component FocusRing inherits Rectangle {
    in property <length> radius: Theme.radius-s;
    border-radius: root.radius + 3px;
    border-width: 2px;
    border-color: Theme.accent;
    Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: root.radius + 6px;
        border-width: 3px;
        border-color: Theme.glow.with-alpha(0.3);
    }
}

// A push button. `variant`: "primary" (accent), "secondary" (default) or
// "ghost" (no fill until hovered). Enter or Space activates it.
export component ActionButton inherits Rectangle {
    in property <string> text;
    // An optional code point from `Icons`, drawn before the text.
    in property <string> icon;
    in property <string> variant: "secondary";
    in property <bool> enabled: true;
    // false: Tab and Shift+Tab skip it; a click or a key chord still works
    // and the screen reader still sees the button. The approval prompt's
    // allow buttons use it (PLAN.md D64): no sequence of Tab, Enter and
    // Space may approve. Do not remove (approval_focus_tests.rs).
    in property <bool> tab-stop: true;
    out property <bool> has-focus: fs.has-focus;
    callback clicked();
    property <bool> primary: root.variant == "primary";
    property <bool> ghost: root.variant == "ghost";
    property <bool> vivid: root.primary && root.enabled;
    min-height: Theme.control-height;
    min-width: Theme.control-height;
    border-radius: Theme.radius-m;
    // Ghost buttons keep the 1px outline too: without it they read as text.
    border-width: root.vivid ? 0px : 1px;
    border-color: !root.enabled ? Theme.line : ta.has-hover ? Theme.accent : Theme.border;
    background: !root.enabled ? (root.ghost ? transparent : Theme.surface)
        : root.primary ? transparent
        : ta.pressed ? Theme.selection : ta.has-hover ? Theme.hover
        : root.ghost ? transparent : Theme.raised;
    animate background, border-color { duration: Theme.quick; }
    opacity: root.enabled ? 1 : 0.6;
    forward-focus: fs;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    // The primary button: the accent gradient, a halo on hover, darker on press.
    if root.vivid && ta.has-hover: Halo { radius: Theme.radius-m; }
    if root.vivid: AccentFill { radius: Theme.radius-m; }
    if root.vivid: Rectangle {
        border-radius: Theme.radius-m;
        background: Theme.shadow.with-alpha(ta.pressed ? 0.22 : 0);
        animate background { duration: Theme.quick; }
    }
    HorizontalLayout {
        padding-left: Theme.space-l - 2px;
        padding-right: Theme.space-l - 2px;
        alignment: center;
        spacing: Theme.space-s;
        if root.icon != "": Mark {
            text: root.icon;
            font-size: Theme.font-m;
            color: !root.enabled ? Theme.dim : root.primary ? Theme.on-accent : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: Theme.font-m;
            font-weight: root.primary ? 600 : 500;
            color: !root.enabled ? Theme.dim : root.primary ? Theme.on-accent : Theme.text;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    fs := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        focus-on-tab-navigation: root.tab-stop;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == " ") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    if fs.has-focus: FocusRing { radius: Theme.radius-m; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

// One row of the dropdown list. A `header` row is a group title: dim, not
// pickable and never highlighted.
component DropdownItem inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <bool> highlighted;
    in property <bool> header;
    callback picked();
    height: Theme.control-height;
    border-radius: Theme.radius-s - 2px;
    background: root.header ? transparent : root.highlighted || ta.has-hover ? Theme.hover : root.selected ? Theme.accent-surface : transparent;
    animate background { duration: Theme.quick; }
    if root.selected && !root.header: Rectangle {
        x: 0;
        y: 8px;
        width: 3px;
        height: parent.height - 16px;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    if root.header: Text {
        x: Theme.space-s;
        width: parent.width - 2 * Theme.space-s;
        height: parent.height;
        text: root.text;
        color: Theme.dim;
        font-size: Theme.font-s;
        font-weight: 600;
        overflow: elide;
        vertical-alignment: center;
        accessible-role: AccessibleRole.text;
    }
    if !root.header: HorizontalLayout {
        width: parent.width;
        height: parent.height;
        padding-left: Theme.space-s;
        padding-right: Theme.space-s;
        spacing: Theme.space-s;
        Mark {
            width: 14px;
            text: root.selected ? Icons.check : "";
            color: Theme.accent;
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: Theme.font-m;
            font-weight: root.selected ? 600 : 400;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: !root.header;
        mouse-cursor: root.header ? default : pointer;
        clicked => { root.picked(); }
    }
}

// A dropdown: the current label and a chevron; a list in a popup.
// Keyboard: Enter, Space or Down open it; Up and Down move; Enter picks;
// Esc closes. `selected(index)` fires after a pick changed `current-index`;
// `opened()` fires each time the list opens (mouse, keyboard or a screen
// reader). While `refreshing`, a mark shows the list is being refetched.
// `headers[i]` true makes row i a group title: Up and Down skip it and
// neither a click nor Enter picks it (two titles are never adjacent).
export component Dropdown inherits Rectangle {
    in property <[string]> model;
    in property <[bool]> headers;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    in property <string> label;
    // Shown (dim) while nothing is picked (`current-index` -1).
    in property <string> placeholder;
    // The list opens above the control (for controls near the bottom).
    in property <bool> drop-up;
    in property <length> list-width: root.width;
    out property <string> current-value: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
    out property <bool> has-focus: fs.has-focus;
    callback selected(int);
    callback opened();
    in property <bool> refreshing;
    in-out property <int> highlight: -1;
    property <length> list-height: min(8, max(1, root.model.length)) * Theme.control-height + 8px;
    property <bool> open;
    // The first row the open list shows: the one before the picked row, so
    // the picked row and the ones after it are in view (a title above it
    // too), and never past the last full page.
    out property <int> first-row: max(0, min(root.highlight - 1, root.model.length - 8));

    function show-list() {
        root.highlight = root.current-index;
        root.open = true;
        popup.show();
        root.opened();
    }
    function is-header(index: int) -> bool {
        return index >= 0 && index < root.headers.length && root.headers[index];
    }
    // The pickable row `delta` rows from `from`, past one title; `from` at an edge.
    function step(from: int, delta: int) -> int {
        if root.is-header(from + delta) {
            return root.stay-or(from, from + 2 * delta);
        }
        return root.stay-or(from, from + delta);
    }
    function stay-or(from: int, next: int) -> int {
        if next < 0 || next >= root.model.length || root.is-header(next) {
            return from;
        }
        return next;
    }
    function pick(index: int) {
        if root.is-header(index) {
            return;
        }
        popup.close();
        root.open = false;
        fs.focus();
        if index >= 0 && index < root.model.length && index != root.current-index {
            root.current-index = index;
            root.selected(index);
        }
    }
    function list-keys(event: KeyEvent) -> EventResult {
        if event.text == Key.UpArrow {
            root.highlight = root.step(root.highlight, -1);
        } else if event.text == Key.DownArrow {
            root.highlight = root.step(root.highlight, 1);
        } else if event.text == Key.Return || event.text == " " {
            root.pick(root.highlight);
        } else if event.text == Key.Escape {
            popup.close();
            root.open = false;
            fs.focus();
        } else {
            return reject;
        }
        return accept;
    }

    min-height: Theme.control-height;
    min-width: 120px;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: !root.enabled ? Theme.line : root.open || ta.has-hover ? Theme.accent : Theme.border;
    background: ta.has-hover && root.enabled ? Theme.hover : Theme.raised;
    animate background, border-color { duration: Theme.quick; }
    opacity: root.enabled ? 1 : 0.6;
    forward-focus: fs;
    accessible-role: combobox;
    accessible-label: root.refreshing ? root.label + ", Refreshing" : root.label;
    accessible-value: root.current-value != "" ? root.current-value : root.placeholder;
    accessible-enabled: root.enabled;
    accessible-expanded: root.open;
    accessible-action-expand => { root.show-list(); }
    accessible-action-default => { root.show-list(); }
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: Theme.space-m - 2px;
        spacing: Theme.space-s;
        Text {
            text: root.current-value != "" ? root.current-value : root.placeholder;
            color: root.current-value != "" ? Theme.text : Theme.dim;
            font-size: Theme.font-m;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
            accessible-role: none;
        }
        if root.refreshing: Mark {
            text: Icons.refresh;
            color: Theme.dim;
            font-size: Theme.font-m;
        }
        Mark {
            text: root.open ? Icons.chevron-up : Icons.chevron-down;
            color: root.open || ta.has-hover ? Theme.accent : Theme.dim;
            font-size: Theme.font-m;
        }
    }

    fs := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " || event.text == Key.DownArrow {
                root.show-list();
                return accept;
            }
            return reject;
        }
    }
    // Above the focus scope, which would otherwise take the press.
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            fs.focus();
            root.show-list();
        }
    }
    if fs.has-focus: FocusRing { radius: Theme.radius-m; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
    popup := PopupWindow {
        x: 0;
        y: root.drop-up ? -root.list-height - 4px : root.height + 4px;
        width: root.list-width;
        height: root.list-height;
        close-policy: close-on-click-outside;
        forward-focus: list-fs;
        list-fs := FocusScope {
            // The list holds the focus while the popup is open; it loses it
            // however the popup closes (a pick, Esc or a click outside).
            focus-changed-event => {
                if !self.has-focus {
                    root.open = false;
                }
            }
            key-pressed(event) => { return root.list-keys(event); }
        }
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-l;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #00000040;
            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.model.length * Theme.control-height;
                content-y: -root.first-row * Theme.control-height;
                for item[i] in root.model: DropdownItem {
                    y: i * Theme.control-height;
                    width: parent.width;
                    text: item;
                    selected: i == root.current-index;
                    highlighted: i == root.highlight;
                    header: root.is-header(i);
                    picked => { root.pick(i); }
                }
            }
        }
    }
}

// A single-line input with a border and a focus ring. `password` hides
// the text without the reveal button of the std LineEdit.
export component KeyInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> read-only;
    out property <bool> has-focus: input.has-focus;
    callback accepted(string);
    public function select-all() { input.select-all(); }
    min-height: Theme.control-height;
    min-width: 80px;
    border-radius: Theme.radius-m;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : hover.has-hover ? Theme.dim : Theme.border;
    background: root.read-only ? Theme.surface : Theme.raised;
    animate border-color { duration: Theme.quick; }
    hover := TouchArea { mouse-cursor: MouseCursor.text; clicked => { input.focus(); } }
    forward-focus: input;
    input := TextInput {
        x: Theme.space-m;
        width: parent.width - 2 * Theme.space-m;
        height: parent.height;
        vertical-alignment: center;
        single-line: true;
        read-only: root.read-only;
        input-type: root.password ? InputType.password : InputType.text;
        font-size: Theme.font-m;
        color: Theme.text;
        selection-background-color: Theme.selection;
        selection-foreground-color: Theme.text;
        accessible-label: root.placeholder;
        accepted => { root.accepted(self.text); }
    }
    if root.text == "" && input.preedit-text == "": Text {
        x: Theme.space-m;
        height: parent.height;
        vertical-alignment: center;
        text: root.placeholder;
        color: Theme.dim;
        font-size: Theme.font-m;
        accessible-role: none;
    }
    if input.has-focus: FocusRing { radius: Theme.radius-m; x: -3px; y: -3px; width: parent.width + 6px; height: parent.height + 6px; }
}

// Three dots that pulse in turn while work runs.
export component BusySpinner {
    in property <string> label: "Running";
    width: 22px;
    height: 14px;
    accessible-role: progress-indicator;
    accessible-label: root.label;
    property <angle> phase: (animation-tick() / 1ms) * 0.36deg;
    for i in 3: Rectangle {
        x: i * 8px;
        y: (parent.height - self.height) / 2;
        width: 6px;
        height: 6px;
        border-radius: 3px;
        background: i == 0 ? Theme.accent : i == 1 ? Theme.accent.mix(Theme.accent2, 0.5) : Theme.accent2;
        opacity: 0.35 + 0.65 * (0.5 + 0.5 * Math.sin(root.phase - i * 60deg));
    }
}
// An icon-only button: a square with one glyph, a hover fill and a label
// for assistive technology. `danger` fills it with the error colour on hover.
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> danger;
    in property <length> icon-size: Theme.font-m + 2px;
    callback clicked();
    width: Theme.control-height;
    height: Theme.control-height;
    border-radius: Theme.radius-m;
    background: ta.pressed ? (root.danger ? Theme.error.darker(0.1) : Theme.selection)
        : ta.has-hover ? (root.danger ? Theme.error : Theme.hover) : transparent;
    animate background { duration: Theme.quick; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Mark {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        text: root.icon;
        font-size: root.icon-size;
        color: root.danger && ta.has-hover ? Theme.bg : Theme.text;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
