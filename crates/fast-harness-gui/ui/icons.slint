// Every icon the GUI draws: code points of the "Fast Harness Icons" font
// (fonts/FastHarnessIcons.ttf, a subset of Symbols Nerd Font v3.5.1),
// named like the Nerd Font glyphs. Draw them with `Mark` (parts.slint).
export global Icons {
    // Window controls (Codicons chrome_*).
    out property <string> chrome-close: "\u{eab8}";
    out property <string> chrome-minimize: "\u{eaba}";
    out property <string> chrome-maximize: "\u{eab9}";
    out property <string> chrome-restore: "\u{eabb}";
    out property <string> layout-sidebar-left: "\u{ebf3}";
    out property <string> layout-sidebar-left-off: "\u{ec02}";
    // Pages and tabs.
    out property <string> account: "\u{eb99}";
    out property <string> settings-gear: "\u{eb51}";
    out property <string> info: "\u{ea74}";
    out property <string> comment-discussion: "\u{eac7}";
    out property <string> pulse: "\u{eb31}";
    // Actions.
    out property <string> add: "\u{ea60}";
    out property <string> send: "\u{ec0f}";
    out property <string> debug-stop: "\u{ead7}";
    out property <string> close: "\u{ea76}";
    out property <string> refresh: "\u{eb37}";
    out property <string> copy: "\u{ebcc}";
    out property <string> trash: "\u{ea81}";
    out property <string> key: "\u{eb11}";
    out property <string> sign-in: "\u{ea6f}";
    out property <string> link-external: "\u{eb14}";
    // Marks next to a word or a colour.
    out property <string> chevron-right: "\u{eab6}";
    out property <string> chevron-down: "\u{eab4}";
    out property <string> chevron-up: "\u{eab7}";
    out property <string> arrow-up: "\u{eaa1}";
    out property <string> arrow-down: "\u{ea9a}";
    out property <string> check: "\u{eab2}";
    out property <string> error: "\u{ea87}";
    out property <string> warning: "\u{ea6c}";
    out property <string> debug-pause: "\u{ead1}";
    out property <string> circle-filled: "\u{ea71}";
    out property <string> git-compare: "\u{eafd}";
    out property <string> list-flat: "\u{eb84}";
    out property <string> tools: "\u{eb6d}";
    // The brand bolt (never U+26A1).
    out property <string> lightning-bolt: "\u{f140b}";
}
