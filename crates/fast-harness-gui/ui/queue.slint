import { Theme, Mark } from "parts.slint";
import { Icons } from "icons.slint";
import { IconButton } from "widgets.slint";
import { QueueChip } from "types.slint";

// One text waiting above the composer (PLAN.md D39): a mark and a word
// ("steer" for a steer the running turn has not read yet, "queued" for a
// follow-up), the text on one line, and an x that removes a queued one.
component ChipLine inherits Rectangle {
    in property <QueueChip> chip;
    callback remove();
    property <bool> steer: root.chip.index < 0;
    height: Theme.control-height;
    border-radius: Theme.radius-m;
    background: Theme.raised;
    border-width: 1px;
    border-color: Theme.line;
    accessible-role: list-item;
    accessible-label: (root.steer ? "steer: " : "queued: ") + root.chip.text;
    HorizontalLayout {
        padding-left: Theme.space-m;
        padding-right: 2px;
        spacing: Theme.space-s;
        Mark {
            text: root.steer ? Icons.comment-discussion : Icons.list-flat;
            color: root.steer ? Theme.accent : Theme.dim;
            font-size: Theme.font-s;
        }
        Text {
            text: root.steer ? "steer" : "queued";
            color: root.steer ? Theme.accent : Theme.dim;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
        Text {
            text: root.chip.text;
            color: Theme.text;
            font-size: Theme.font-s;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if !root.steer: IconButton {
            icon: Icons.close;
            label: "Remove from the queue";
            icon-size: Theme.font-s;
            clicked => { root.remove(); }
        }
    }
}

// The chips of the shown session, one per line; `remove(index)` drops
// queued text `index`.
export component QueueChips inherits VerticalLayout {
    in property <[QueueChip]> chips;
    callback remove(int);
    spacing: 4px;
    for c in root.chips: ChipLine {
        chip: c;
        remove => { root.remove(c.index); }
    }
}
