import { Palette } from "std-widgets.slint";
import { MsgRow, SessionRow, SideRow, AccountRow, TraceRow, GoogleRow, GoogleQuotaRow, ProviderCard, QueueChip } from "types.slint";
import { QueueChips } from "queue.slint";
import { Theme } from "parts.slint";
import { Dropdown } from "widgets.slint";
import { Composer } from "composer.slint";
import { TranscriptView } from "transcript.slint";
import { Sidebar } from "sidebar.slint";
import { AccountsPage } from "accounts.slint";
import { SettingsPage, AboutPage } from "pages.slint";
export { PromptUi } from "prompt_settings.slint";
export { AppearanceUi, ThemeCard } from "appearance.slint";
export { ConfigUi, ConfigRow } from "config_settings.slint";
import { TracePage } from "trace.slint";
export { TraceProbe } from "trace.slint";
import { TitleBar } from "titlebar.slint";
import { TabStrip, StatusBar, ErrorBanner } from "panel.slint";
// The icon font (Symbols Nerd Font subset); `Theme.symbols` names it.
import "../fonts/FastHarnessIcons.ttf";

export { MsgRow, SessionRow, SideRow, AccountRow, TraceRow, GoogleRow, GoogleQuotaRow, ProviderCard, QueueChip, Theme }

// No native frame: the title bar (titlebar.slint) draws the window
// controls; a 1px line edges the window while it is not maximized.
export component MainWindow inherits Window {
    title: "Fast Harness";
    icon: @image-url("../assets/fast-harness-256.png");
    no-frame: true;
    resize-border-width: 6px;
    preferred-width: 1100px;
    preferred-height: 740px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.bg;
    default-font-size: Theme.font-m;

    in-out property <bool> sidebar-open: true;

    in property <[MsgRow]> messages;
    // True while the transcript follows new output (read by the tests).
    out property <bool> transcript-follow: transcript.follow;
    // The transcript scroll bar's thumb centre (read by the tests).
    out property <length> transcript-thumb-x: transcript.thumb-x;
    out property <length> transcript-thumb-y: transcript.thumb-y;
    // The transcript rows' measured height (read by the layout tests).
    out property <length> transcript-content-height: transcript.content-height;
    in property <[SideRow]> side-rows;
    in property <[AccountRow]> accounts;
    in property <[GoogleRow]> google-accounts;
    // The Accounts page: the provider cards and the open provider ("" for the cards).
    in property <[ProviderCard]> providers;
    in-out property <string> accounts-provider;
    in property <bool> google-client-ready;
    in property <string> google-client-id;
    in property <string> google-client-note;
    in property <bool> google-client-error;
    in property <[TraceRow]> trace-entries;
    in property <[[string]]> trace-steps;
    in property <string> trace-session;
    in property <string> trace-message;
    in-out property <string> trace-mode: "timeline";
    in property <[string]> models;
    // True for the provider title rows of `models` (Claude, Google Antigravity).
    in property <[bool]> model-headers;
    in property <[string]> efforts;
    in-out property <int> model-index;
    in-out property <int> effort-index;
    // Shown under the pickers until the next send.
    in property <string> picker-note;
    // A model list fetch runs (started when a model or effort list opens).
    in property <bool> models-refreshing;
    // The real maximized state, set by the app (window_state.rs).
    in property <bool> win-maximized;
    in-out property <string> page: "chat";
    // The shown session runs a turn (D39: each session has its own).
    in property <bool> busy;
    // Steers not yet read and queued follow-ups of the shown session.
    in property <[QueueChip]> queue-chips;
    // How the shown session's last turn stopped when Resume applies.
    in property <string> resume-word;
    in-out property <string> error-text;
    in property <string> status-state: "Ready";
    in property <string> status-model;
    in property <string> status-account;
    in property <string> status-tokens;
    in property <string> status-timing;
    in property <string> login-url;
    in property <string> accounts-message;
    in property <bool> accounts-working;
    in-out property <bool> adding-key;
    in property <string> version;

    // Returns true when the text was accepted (the input is then cleared).
    callback send(string) -> bool;
    callback stop();
    // Alt+Enter: a follow-up while busy (else a send); true when taken.
    callback queue(string) -> bool;
    callback pause();
    callback resume();
    callback remove-queued(int);
    callback new-session();
    callback open-session(string, string);
    callback add-workspace();
    callback select-workspace(string);
    callback remove-workspace(string);
    callback open-page(string);
    callback toggle(int);
    callback open-url(string);
    callback sign-in();
    callback cancel-sign-in();
    callback add-key(string, string);
    callback refresh-usage();
    callback use-account(string);
    callback remove-account(string);
    callback google-sign-in();
    callback google-use(string);
    callback google-remove(string);
    callback google-save-client(string, string);
    callback refresh-trace();
    callback trace-toggle(int);
    callback model-picked(int);
    callback effort-picked(int);
    // A model or effort list opened: the app refetches the model list.
    callback pickers-opened();
    // Window controls: the app reads and changes the real window state.
    callback window-minimize();
    callback window-toggle-maximize();
    // A click on the empty title bar (two within 500 ms maximize or restore).
    callback title-bar-clicked();

    // Copy: a hidden TextInput takes the text, selects it and copies it
    // (StyledText has no selection in Slint 1.18).
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    public function to-bottom() {
        transcript.to-bottom();
    }

    // The std widgets left (scroll bars, AboutSlint) follow this scheme.
    public function set-color-scheme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    function submit() {
        if (root.send(composer.text)) {
            composer.text = "";
            transcript.to-bottom();
        }
    }

    function queue-text() {
        if (root.queue(composer.text)) {
            composer.text = "";
            transcript.to-bottom();
        }
    }

    clip := TextInput {
        width: 0px;
        height: 0px;
        opacity: 0;
    }

    // The backdrop: bg at the top left to bg-end at the bottom right. The
    // window background itself cannot be a gradient in the software
    // renderer; a full-bleed square rectangle can.
    Rectangle { background: @linear-gradient(135deg, Theme.bg 0%, Theme.bg-end 100%); }
    // The brand line along the top edge (square, so the gradient renders).
    Rectangle {
        y: 0;
        height: 2px;
        background: @linear-gradient(90deg, Theme.accent 0%, Theme.accent2 100%);
    }


    VerticalLayout {
        TitleBar {
            page: root.page;
            sidebar-open: root.sidebar-open;
            maximized: root.win-maximized;
            toggle-sidebar => { root.sidebar-open = !root.sidebar-open; }
            open-page(p) => { root.open-page(p); }
            minimize => { root.window-minimize(); }
            toggle-maximize => { root.window-toggle-maximize(); }
            bar-clicked => { root.title-bar-clicked(); }
            close => { root.close(); }
        }
        HorizontalLayout {
            // Without the sidebar the card stays inset, so its rounded
            // corner does not sit on the window edge.
            padding-left: root.sidebar-open ? 0px : Theme.space-s;
            if root.sidebar-open: Sidebar {
                rows: root.side-rows;
                page: root.page;
                new-session => { root.new-session(); }
                add-workspace => { root.add-workspace(); }
                select-workspace(path) => { root.select-workspace(path); }
                remove-workspace(path) => { root.remove-workspace(path); }
                open-session(ws, id) => { root.open-session(ws, id); }
                open-page(p) => { root.open-page(p); }
            }
            // The main card: rounded top-left corner, flush right and bottom.
            // A translucent bg fill over the backdrop: a solid fill keeps its
            // rounded corner in the software renderer, a gradient would not.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg.with-alpha(0.55);
                border-top-left-radius: Theme.radius-xl;
                // No child may paint square over the rounded corner.
                clip: true;
                VerticalLayout {
                    TabStrip {
                        page: root.page;
                        open-page(p) => { root.open-page(p); }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                        // The pages are see-through (the backdrop shows), so
                        // the chat hides while another page is open.
                        Rectangle {
                        visible: root.page == "chat";
                        chat := VerticalLayout {
                            // The banner and the composer sit in a centred column;
                            // explicit geometry keeps the width out of the layout.
                            property <length> column: min(self.width - 2 * Theme.space-l, Theme.column-width);
                            if root.error-text != "": Rectangle {
                                height: banner.preferred-height + Theme.space-m;
                                banner := ErrorBanner {
                                    x: (parent.width - self.width) / 2;
                                    y: Theme.space-m;
                                    width: chat.column;
                                    height: self.preferred-height;
                                    text: root.error-text;
                                    dismiss => { root.error-text = ""; }
                                }
                            }
                            transcript := TranscriptView {
                                vertical-stretch: 1;
                                rows: root.messages;
                                toggle(i) => { root.toggle(i); }
                                copy(t) => { root.copy-text(t); }
                                link(u) => { root.open-url(u); }
                            }
                            if root.queue-chips.length > 0: Rectangle {
                                height: chips.preferred-height + Theme.space-s;
                                chips := QueueChips {
                                    x: (parent.width - self.width) / 2;
                                    y: Theme.space-s;
                                    width: chat.column;
                                    height: self.preferred-height;
                                    chips: root.queue-chips;
                                    remove(i) => { root.remove-queued(i); }
                                }
                            }
                            Rectangle {
                                height: composer.preferred-height + Theme.space-s + Theme.space-l;
                                composer := Composer {
                                    x: (parent.width - self.width) / 2;
                                    y: Theme.space-s;
                                    width: chat.column;
                                    height: self.preferred-height;
                                    busy: root.busy;
                                    note: root.picker-note;
                                    resume-word: root.resume-word;
                                    submit => { root.submit(); }
                                    queue => { root.queue-text(); }
                                    stop => { root.stop(); }
                                    pause => { root.pause(); }
                                    resume => { root.resume(); }
                                    Dropdown {
                                        label: "Model";
                                        min-width: 200px;
                                        max-width: 200px;
                                        drop-up: true;
                                        list-width: 320px;
                                        model: root.models;
                                        headers: root.model-headers;
                                        current-index <=> root.model-index;
                                        refreshing: root.models-refreshing;
                                        selected(i) => { root.model-picked(i); }
                                        opened => { root.pickers-opened(); }
                                    }
                                    Dropdown {
                                        label: "Thinking effort";
                                        placeholder: "default";
                                        min-width: 110px;
                                        max-width: 110px;
                                        drop-up: true;
                                        model: root.efforts;
                                        current-index <=> root.effort-index;
                                        refreshing: root.models-refreshing;
                                        selected(i) => { root.effort-picked(i); }
                                        opened => { root.pickers-opened(); }
                                    }
                                }
                            }
                        }
                        }
                        if root.page == "accounts": AccountsPage {
                            width: parent.width;
                            height: parent.height;
                            accounts: root.accounts;
                            google-accounts: root.google-accounts;
                            google-sign-in => { root.google-sign-in(); }
                            google-use(id) => { root.google-use(id); }
                            google-remove(id) => { root.google-remove(id); }
                            providers: root.providers;
                            provider <=> root.accounts-provider;
                            client-ready: root.google-client-ready;
                            client-id: root.google-client-id;
                            client-note: root.google-client-note;
                            client-error: root.google-client-error;
                            save-client(id, secret) => { root.google-save-client(id, secret); }
                            login-url: root.login-url;
                            message: root.accounts-message;
                            working: root.accounts-working;
                            adding-key <=> root.adding-key;
                            sign-in => { root.sign-in(); }
                            cancel-sign-in => { root.cancel-sign-in(); }
                            add-key(k, l) => { root.add-key(k, l); }
                            refresh => { root.refresh-usage(); }
                            use(id) => { root.use-account(id); }
                            remove(id) => { root.remove-account(id); }
                            open-url(u) => { root.open-url(u); }
                            copy(t) => { root.copy-text(t); }
                        }
                        if root.page == "trace": TracePage {
                            width: parent.width;
                            height: parent.height;
                            entries: root.trace-entries;
                            steps: root.trace-steps;
                            session: root.trace-session;
                            message: root.trace-message;
                            mode <=> root.trace-mode;
                            refresh => { root.refresh-trace(); }
                            toggle(i) => { root.trace-toggle(i); }
                            copy(t) => { root.copy-text(t); }
                        }
                        if root.page == "settings": SettingsPage {
                            width: parent.width;
                            height: parent.height;
                            models: root.models;
                            model-headers: root.model-headers;
                            efforts: root.efforts;
                            model-index <=> root.model-index;
                            effort-index <=> root.effort-index;
                            note: root.picker-note;
                            model-picked(i) => { root.model-picked(i); }
                            effort-picked(i) => { root.effort-picked(i); }
                            pickers-opened => { root.pickers-opened(); }
                            refreshing: root.models-refreshing;
                        }
                        if root.page == "about": AboutPage {
                            width: parent.width;
                            height: parent.height;
                            version: root.version;
                        }
                    }
                    StatusBar {
                        state: root.status-state;
                        model: root.status-model;
                        account: root.status-account;
                        tokens: root.status-tokens;
                        timing: root.status-timing;
                    }
                }
                // The border paints over the clipped children, so it follows
                // the curve with no gap between the line and the fill.
                Rectangle {
                    border-top-left-radius: Theme.radius-xl;
                    border-width: 1px;
                    border-color: Theme.line;
                }
            }
        }
    }
    // The window edge (no shadow on a frameless window).
    if !root.win-maximized: Rectangle {
        border-width: 1px;
        border-color: Theme.line;
    }
}
